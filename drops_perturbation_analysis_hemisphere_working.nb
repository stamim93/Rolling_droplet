Cell[BoxData[
 RowBox[{
  RowBox[{"magkl1mn2", "[", 
   RowBox[{
   "oh_", ",", "\[Rho]1_", ",", "\[Rho]2_", ",", "\[Mu]1_", ",", "\[Mu]2_", 
    ",", "k_", ",", "l_", ",", "m_"}], "]"}], ":=", 
  RowBox[{"(", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"wem", "=", 
     FractionBox[
      RowBox[{"m", 
       RowBox[{"(", 
        RowBox[{"m", "+", "1"}], ")"}], 
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["m", "2"], "+", "m", "-", "2"}], ")"}]}], 
      RowBox[{
       RowBox[{"\[Rho]1", "*", 
        RowBox[{"(", 
         RowBox[{"m", "+", "1"}], ")"}]}], "+", 
       RowBox[{"\[Rho]2", "*", "m"}]}]]}], ";", 
    RowBox[{"delta", "=", 
     FractionBox["oh", "wem"]}], ";", 
    RowBox[{"\[Zeta]k", "=", 
     SqrtBox[
      FractionBox[
       RowBox[{"k", 
        RowBox[{"(", 
         RowBox[{"k", "+", "1"}], ")"}], 
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["k", "2"], "+", "k", "-", "2"}], ")"}]}], 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"\[Rho]1", "*", 
           RowBox[{"(", 
            RowBox[{"k", "+", "1"}], ")"}]}], "+", 
          RowBox[{"\[Rho]2", "*", "k"}]}], ")"}], "wem"}]]]}], ";", 
    RowBox[{"fk", "=", 
     FractionBox[
      RowBox[{"k", 
       RowBox[{"(", 
        RowBox[{"k", "+", "1"}], ")"}]}], 
      RowBox[{
       RowBox[{"\[Rho]1", 
        RowBox[{"(", 
         RowBox[{"k", "+", "1"}], ")"}]}], "+", 
       RowBox[{"\[Rho]2", "*", "k"}]}]]}], ";", 
    RowBox[{"\[CapitalDelta]k", "=", 
     RowBox[{"delta", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"\[Mu]1", "*", 
         RowBox[{"(", 
          RowBox[{"k", "-", "1"}], ")"}]}], "+", 
        RowBox[{"\[Mu]2", "*", 
         RowBox[{"(", 
          RowBox[{"k", "+", "2"}], ")"}]}]}], ")"}], "*", "fk"}]}], ";", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"qkl", "=", 
     RowBox[{"Integrate", "[", 
