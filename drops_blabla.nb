Cell[BoxData[
 RowBox[{
  RowBox[{"epwe1", "[", "we_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "sols", "}"}], ",", 
    RowBox[{
     RowBox[{"sols", "=", 
      RowBox[{"\[Epsilon]", "/.", " ", 
       RowBox[{"Solve", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"zetak", "-", "1", "-", 
           RowBox[{
            SuperscriptBox["\[Epsilon]", "2"], "*", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"1", "/", "2"}], ")"}], " ", 
              RowBox[{"(", 
               RowBox[{"g2", "+", "g3", "-", 
                RowBox[{"\[Sqrt]", 
                 RowBox[{"(", 
                  RowBox[{
                   SuperscriptBox[
                    RowBox[{"(", 
                    RowBox[{"g2", "-", "g3"}], ")"}], "2"], "+", 
                   RowBox[{
                    RowBox[{"(", 
                    RowBox[{"4", " ", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"2", " ", "\[CapitalDelta]k"}], "+", 
                    RowBox[{"g1", " ", 
                    SuperscriptBox["\[Epsilon]", "2"]}]}], ")"}], " ", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"-", "2"}], " ", "\[CapitalDelta]k"}], "+", 
                    RowBox[{"g4", " ", 
                    SuperscriptBox["\[Epsilon]", "2"]}]}], ")"}]}], ")"}], 
                    "/", 
                    SuperscriptBox["\[Epsilon]", "4"]}]}], ")"}]}]}], ")"}]}],
              ")"}]}]}], "==", "0"}], ",", "\[Epsilon]"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sols", "=", 
      RowBox[{"Map", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Abs", "[", 
             RowBox[{"Im", "[", "#", "]"}], "]"}], "<", 
            RowBox[{"10", "^", 
             RowBox[{"-", "6"}]}]}], ",", 
           RowBox[{"Re", "[", "#", "]"}], ",", "#"}], "]"}], "&"}], ",", 
        "sols"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"sols", "=", 
      RowBox[{"Select", "[", 
       RowBox[{"sols", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"Element", "[", 
           RowBox[{"#", ",", "Reals"}], "]"}], "&&", 
          RowBox[{"#", ">", "0"}]}], "&"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
