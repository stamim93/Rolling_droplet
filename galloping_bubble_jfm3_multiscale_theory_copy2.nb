                   RowBox[{"2", " ", "\[CapitalDelta]k", " ", 
                    RowBox[{"Cos", "[", "t", "]"}]}], "+", 
                   RowBox[{"Sin", "[", "t", "]"}], "-", 
                   RowBox[{
                    SuperscriptBox["\[Zeta]k", "2"], " ", 
                    RowBox[{"Sin", "[", "t", "]"}]}]}], ")"}]}], 
                RowBox[{"1", "+", 
                 RowBox[{"4", " ", 
                  SuperscriptBox["\[CapitalDelta]k", "2"]}], "-", 
                 RowBox[{"2", " ", 
                  SuperscriptBox["\[Zeta]k", "2"]}], "+", 
                 SuperscriptBox["\[Zeta]k", "4"]}]]}], "/.", 
              RowBox[{"t", "->", "0"}]}], ")"}], "==", "ic1"}], ",", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"D", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  SuperscriptBox["\[ExponentialE]", 
                   RowBox[{
                    RowBox[{"-", "t"}], " ", 
                    RowBox[{"(", 
                    RowBox[{"\[CapitalDelta]k", "+", 
                    SqrtBox[
                    RowBox[{
                    SuperscriptBox["\[CapitalDelta]k", "2"], "-", 
                    SuperscriptBox["\[Zeta]k", "2"]}]]}], ")"}]}]], " ", 
                  RowBox[{"(", 
                   RowBox[{"ckl", "+", 
                    RowBox[{"dkl", " ", 
