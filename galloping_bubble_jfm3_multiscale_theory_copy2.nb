Cell[BoxData[
 RowBox[{
  RowBox[{"bkl1trans", "[", 
   RowBox[{
   "ic1_", ",", "ic2_", ",", "oh_", ",", "we_", ",", "k_", ",", "l_"}], "]"}],
   ":=", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"Clear", "[", 
     RowBox[{"ckl", ",", "dkl"}], "]"}], ";", "\[IndentingNewLine]", 
    RowBox[{"\[CapitalDelta]k", "=", 
     RowBox[{
      FractionBox["oh", 
       SqrtBox["we"]], "*", 
      RowBox[{"(", 
       RowBox[{"k", "+", "1"}], ")"}], "*", 
      RowBox[{"(", 
       RowBox[{"k", "+", "2"}], ")"}]}]}], ";", 
    RowBox[{"\[Zeta]k", "=", 
     SqrtBox[
      RowBox[{
       FractionBox["1", "we"], 
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["k", "2"], "-", "1"}], ")"}], 
       RowBox[{"(", 
        RowBox[{"k", "+", "2"}], ")"}]}]]}], ";", "\[IndentingNewLine]", 
    RowBox[{"qkl", "=", 
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Cos", "[", "\[Theta]", "]"}], "*", 
        RowBox[{"realkl", "[", 
         RowBox[{"k", ",", "l"}], "]"}], "*", 
        RowBox[{"Sin", "[", "\[Theta]", "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Theta]", ",", "0", ",", 
         RowBox[{"Pi", "/", "2"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[CurlyPhi]", ",", "0", ",", 
         RowBox[{"2", "Pi"}]}], "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"icsol", "=", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ckl", ",", "dkl"}], "}"}], "/.", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Solve", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{
                SuperscriptBox["\[ExponentialE]", 
                 RowBox[{
                  RowBox[{"-", "t"}], " ", 
                  RowBox[{"(", 
                   RowBox[{"\[CapitalDelta]k", "+", 
                    SqrtBox[
                    RowBox[{
                    SuperscriptBox["\[CapitalDelta]k", "2"], "-", 
                    SuperscriptBox["\[Zeta]k", "2"]}]]}], ")"}]}]], " ", 
                RowBox[{"(", 
                 RowBox[{"ckl", "+", 
                  RowBox[{"dkl", " ", 
                   SuperscriptBox["\[ExponentialE]", 
                    RowBox[{"2", " ", "t", " ", 
                    SqrtBox[
                    RowBox[{
                    SuperscriptBox["\[CapitalDelta]k", "2"], "-", 
                    SuperscriptBox["\[Zeta]k", "2"]}]]}]]}]}], ")"}]}], "-", 
               FractionBox[
                RowBox[{"2", " ", 
                 RowBox[{"(", 
                  RowBox[{"1", "+", "k"}], ")"}], " ", "qkl", " ", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"2", " ", "\[CapitalDelta]k", " ", 
                    RowBox[{"Cos", "[", "t", "]"}]}], "+", 
                   RowBox[{"Sin", "[", "t", "]"}], "-", 
                   RowBox[{
                    SuperscriptBox["\[Zeta]k", "2"], " ", 
                    RowBox[{"Sin", "[", "t", "]"}]}]}], ")"}]}], 
                RowBox[{"1", "+", 
                 RowBox[{"4", " ", 
                  SuperscriptBox["\[CapitalDelta]k", "2"]}], "-", 
                 RowBox[{"2", " ", 
                  SuperscriptBox["\[Zeta]k", "2"]}], "+", 
                 SuperscriptBox["\[Zeta]k", "4"]}]]}], "/.", 
              RowBox[{"t", "->", "0"}]}], ")"}], "==", "ic1"}], ",", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"D", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  SuperscriptBox["\[ExponentialE]", 
                   RowBox[{
                    RowBox[{"-", "t"}], " ", 
                    RowBox[{"(", 
                    RowBox[{"\[CapitalDelta]k", "+", 
                    SqrtBox[
                    RowBox[{
                    SuperscriptBox["\[CapitalDelta]k", "2"], "-", 
                    SuperscriptBox["\[Zeta]k", "2"]}]]}], ")"}]}]], " ", 
                  RowBox[{"(", 
                   RowBox[{"ckl", "+", 
                    RowBox[{"dkl", " ", 
                    SuperscriptBox["\[ExponentialE]", 
                    RowBox[{"2", " ", "t", " ", 
                    SqrtBox[
                    RowBox[{
                    SuperscriptBox["\[CapitalDelta]k", "2"], "-", 
                    SuperscriptBox["\[Zeta]k", "2"]}]]}]]}]}], ")"}]}], "-", 
                 FractionBox[
                  RowBox[{"2", " ", 
                   RowBox[{"(", 
                    RowBox[{"1", "+", "k"}], ")"}], " ", "qkl", " ", 
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{"2", " ", "\[CapitalDelta]k", " ", 
                    RowBox[{"Cos", "[", "t", "]"}]}], "+", 
                    RowBox[{"Sin", "[", "t", "]"}], "-", 
                    RowBox[{
                    SuperscriptBox["\[Zeta]k", "2"], " ", 
                    RowBox[{"Sin", "[", "t", "]"}]}]}], ")"}]}], 
                  RowBox[{"1", "+", 
                   RowBox[{"4", " ", 
                    SuperscriptBox["\[CapitalDelta]k", "2"]}], "-", 
                   RowBox[{"2", " ", 
                    SuperscriptBox["\[Zeta]k", "2"]}], "+", 
                   SuperscriptBox["\[Zeta]k", "4"]}]]}], ",", "t"}], "]"}], "/.", 
              RowBox[{"t", "->", "0"}]}], ")"}], "==", "ic2"}]}], "}"}], ",", 
         
         RowBox[{"{", 
          RowBox[{"ckl", ",", "dkl"}], "}"}]}], "]"}], "]"}]}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"bkl1ivpsol", "=", 
     RowBox[{
      RowBox[{
       RowBox[{
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{
          RowBox[{"-", "t"}], " ", 
          RowBox[{"(", 
           RowBox[{"\[CapitalDelta]k", "+", 
            SqrtBox[
             RowBox[{
              SuperscriptBox["\[CapitalDelta]k", "2"], "-", 
              SuperscriptBox["\[Zeta]k", "2"]}]]}], ")"}]}]], " ", 
        RowBox[{"(", 
         RowBox[{"ckl", "+", 
          RowBox[{"dkl", " ", 
           SuperscriptBox["\[ExponentialE]", 
            RowBox[{"2", " ", "t", " ", 
             SqrtBox[
              RowBox[{
               SuperscriptBox["\[CapitalDelta]k", "2"], "-", 
               SuperscriptBox["\[Zeta]k", "2"]}]]}]]}]}], ")"}]}], "-", 
       FractionBox[
        RowBox[{"2", " ", 
         RowBox[{"(", 
          RowBox[{"1", "+", "k"}], ")"}], " ", "qkl", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"2", " ", "\[CapitalDelta]k", " ", 
            RowBox[{"Cos", "[", "t", "]"}]}], "+", 
           RowBox[{"Sin", "[", "t", "]"}], "-", 
           RowBox[{
            SuperscriptBox["\[Zeta]k", "2"], " ", 
            RowBox[{"Sin", "[", "t", "]"}]}]}], ")"}]}], 
        RowBox[{"1", "+", 
         RowBox[{"4", " ", 
          SuperscriptBox["\[CapitalDelta]k", "2"]}], "-", 
         RowBox[{"2", " ", 
          SuperscriptBox["\[Zeta]k", "2"]}], "+", 
         SuperscriptBox["\[Zeta]k", "4"]}]]}], "/.", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"ckl", "->", 
         RowBox[{"icsol", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], ",", 
        RowBox[{"dkl", "->", 
         RowBox[{"icsol", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}]}]}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"bkl0amp", "=", 
     FractionBox[
      RowBox[{"2", " ", 
       RowBox[{"(", 
        RowBox[{"1", "+", "k"}], ")"}], " ", "qk", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", " ", "\[CapitalDelta]k", " ", 
          RowBox[{"Cos", "[", "t", "]"}]}], "+", 
         RowBox[{"Sin", "[", "t", "]"}], "-", 
         RowBox[{
          SuperscriptBox["\[Zeta]k", "2"], " ", 
          RowBox[{"Sin", "[", "t", "]"}]}]}], ")"}]}], 
      RowBox[{"1", "+", 
       RowBox[{"4", " ", 
        SuperscriptBox["\[CapitalDelta]k", "2"]}], "-", 
       RowBox[{"2", " ", 
        SuperscriptBox["\[Zeta]k", "2"]}], "+", 
       SuperscriptBox["\[Zeta]k", "4"]}]]}], "*)"}], 
   RowBox[{"(*", 
    RowBox[{"before", " ", "forcing", " ", "sign", " ", "correction"}], 
