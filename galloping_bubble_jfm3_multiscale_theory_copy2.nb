Cell[BoxData[
 RowBox[{
  RowBox[{"psikl1", "[", 
   RowBox[{"oh_", ",", "we_", ",", "k_", ",", "l_"}], "]"}], ":=", 
  RowBox[{"(", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[CapitalDelta]k", "=", 
     RowBox[{
      FractionBox["oh", 
       SqrtBox["we"]], "*", 
      RowBox[{"(", 
       RowBox[{"k", "+", "1"}], ")"}], "*", 
      RowBox[{"(", 
       RowBox[{"k", "+", "2"}], ")"}]}]}], ";", 
    RowBox[{"\[Zeta]k", "=", 
     SqrtBox[
      RowBox[{
       FractionBox["1", "we"], 
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["k", "2"], "-", "1"}], ")"}], 
       RowBox[{"(", 
        RowBox[{"k", "+", "2"}], ")"}]}]]}], ";", "\[IndentingNewLine]", 
    RowBox[{"qkl", "=", 
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Cos", "[", "\[Theta]", "]"}], "*", 
        RowBox[{"realkl", "[", 
         RowBox[{"k", ",", "l"}], "]"}], "*", 
        RowBox[{"Sin", "[", "\[Theta]", "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Theta]", ",", "0", ",", 
         RowBox[{"Pi", "/", "2"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[CurlyPhi]", ",", "0", ",", 
         RowBox[{"2", "Pi"}]}], "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"d1", "=", 
     RowBox[{"Coefficient", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "2"}], "*", 
        RowBox[{"Sign", "[", "qkl", "]"}], "*", 
        RowBox[{"(", 
         RowBox[{"k", "+", "1"}], ")"}], 
        RowBox[{"(", 
         FractionBox[
          RowBox[{
           RowBox[{"2", " ", "\[CapitalDelta]k", " ", 
            RowBox[{"Cos", "[", "tt", "]"}]}], "+", 
           RowBox[{"Sin", "[", "tt", "]"}], "-", 
           RowBox[{
            SuperscriptBox["\[Zeta]k", "2"], " ", 
            RowBox[{"Sin", "[", "tt", "]"}]}]}], 
          RowBox[{"1", "+", 
           RowBox[{"4", " ", 
            SuperscriptBox["\[CapitalDelta]k", "2"]}], "-", 
           RowBox[{"2", " ", 
            SuperscriptBox["\[Zeta]k", "2"]}], "+", 
           SuperscriptBox["\[Zeta]k", "4"]}]], ")"}]}], ",", 
       RowBox[{"Cos", "[", "tt", "]"}]}], "]"}]}], ";", "\n", 
    RowBox[{"d2", "=", 
     RowBox[{"Coefficient", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "2"}], "*", 
        RowBox[{"Sign", "[", "qkl", "]"}], "*", 
        RowBox[{"(", 
         RowBox[{"k", "+", "1"}], ")"}], 
        RowBox[{"(", 
         FractionBox[
          RowBox[{
           RowBox[{"2", " ", "\[CapitalDelta]k", " ", 
            RowBox[{"Cos", "[", "tt", "]"}]}], "+", 
           RowBox[{"Sin", "[", "tt", "]"}], "-", 
           RowBox[{
            SuperscriptBox["\[Zeta]k", "2"], " ", 
            RowBox[{"Sin", "[", "tt", "]"}]}]}], 
          RowBox[{"1", "+", 
           RowBox[{"4", " ", 
            SuperscriptBox["\[CapitalDelta]k", "2"]}], "-", 
           RowBox[{"2", " ", 
            SuperscriptBox["\[Zeta]k", "2"]}], "+", 
           SuperscriptBox["\[Zeta]k", "4"]}]], ")"}]}], ",", 
       RowBox[{"Sin", "[", "tt", "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"psi", "=", 
     RowBox[{"ArcTan", "[", 
      RowBox[{"d2", ",", 
       RowBox[{"-", "d1"}]}], "]"}]}]}], ")"}]}]], "Input",
 InitializationCell->True,
