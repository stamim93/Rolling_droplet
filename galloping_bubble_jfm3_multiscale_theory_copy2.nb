Cell[BoxData[
 RowBox[{
  RowBox[{"bk0steady", "[", 
   RowBox[{"oh_", ",", "bo_", ",", "\[Epsilon]_", ",", "we_", ",", "k_"}], 
   "]"}], ":=", 
  RowBox[{"(", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"kr", "=", 
      RowBox[{"number", " ", "of", " ", "resonance", " ", "mode"}]}], ",", 
     " ", 
     RowBox[{"e", ".", "g", "."}], ",", " ", 
     RowBox[{"kr", "=", "3"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"delta", "=", 
     FractionBox["oh", 
      SqrtBox["we"]]}], ";", 
    RowBox[{"\[CapitalDelta]k", "=", 
     RowBox[{"delta", "*", 
      RowBox[{"(", 
       RowBox[{"k", "+", "1"}], ")"}], "*", 
      RowBox[{"(", 
       RowBox[{"k", "+", "2"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"qk", "=", 
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Cos", "[", "\[Theta]", "]"}], "*", 
        RowBox[{"SphericalHarmonicY", "[", 
         RowBox[{"k", ",", "0", ",", "\[Theta]", ",", "\[CurlyPhi]"}], "]"}], 
        "*", 
        RowBox[{"Sin", "[", "\[Theta]", "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Theta]", ",", "0", ",", 
         RowBox[{"Pi", "/", "2"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[CurlyPhi]", ",", "0", ",", 
         RowBox[{"2", "Pi"}]}], "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
    
    RowBox[{"\[Zeta]k", "=", 
     SqrtBox[
      RowBox[{
       FractionBox["1", "we"], 
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["k", "2"], "-", "1"}], ")"}], 
       RowBox[{"(", 
        RowBox[{"k", "+", "2"}], ")"}]}]]}], ";", "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{"bkl0amp", "=", 
      FractionBox[
       RowBox[{"2", " ", 
        RowBox[{"(", 
         RowBox[{"1", "+", "k"}], ")"}], " ", "qk", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", " ", "\[CapitalDelta]k", " ", 
           RowBox[{"Cos", "[", "t", "]"}]}], "+", 
          RowBox[{"Sin", "[", "t", "]"}], "-", 
          RowBox[{
           SuperscriptBox["\[Zeta]k", "2"], " ", 
           RowBox[{"Sin", "[", "t", "]"}]}]}], ")"}]}], 
       RowBox[{"1", "+", 
        RowBox[{"4", " ", 
         SuperscriptBox["\[CapitalDelta]k", "2"]}], "-", 
        RowBox[{"2", " ", 
         SuperscriptBox["\[Zeta]k", "2"]}], "+", 
        SuperscriptBox["\[Zeta]k", "4"]}]]}], "*)"}], 
    RowBox[{"(*", 
     RowBox[{"before", " ", "forcing", " ", "sign", " ", "correction"}], 
     "*)"}], "\[IndentingNewLine]", 
    RowBox[{"bkl0amp", "=", 
     RowBox[{"-", 
      FractionBox[
       RowBox[{"2", " ", 
        RowBox[{"(", 
         RowBox[{"1", "+", "k"}], ")"}], " ", "qk", " ", 
        RowBox[{"(", 
