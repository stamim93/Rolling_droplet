           RowBox[{"2", " ", "\[CapitalDelta]k", " ", 
            RowBox[{"Cos", "[", 
             RowBox[{"t", "*", 
              RowBox[{"(", 
               RowBox[{"2", "Pi"}], ")"}]}], "]"}]}], "+", 
           RowBox[{"Sin", "[", 
            RowBox[{"t", "*", 
             RowBox[{"(", 
              RowBox[{"2", "Pi"}], ")"}]}], "]"}], "-", 
           RowBox[{
            SuperscriptBox["\[Zeta]k", "2"], " ", 
            RowBox[{"Sin", "[", 
             RowBox[{"t", "*", 
              RowBox[{"(", 
               RowBox[{"2", "Pi"}], ")"}]}], "]"}]}]}], ")"}]}], 
        RowBox[{"1", "+", 
         RowBox[{"4", " ", 
          SuperscriptBox["\[CapitalDelta]k", "2"]}], "-", 
         RowBox[{"2", " ", 
