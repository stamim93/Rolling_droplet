Cell[BoxData[
 RowBox[{
  RowBox[{"fixedpointcos", "[", 
   RowBox[{"kr_", ",", "we_", ",", "\[Epsilon]_"}], "]"}], ":=", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{
     RowBox[{"solset", "=", 
      RowBox[{"{", "}"}]}], ";", 
     RowBox[{"Clear", "[", 
      RowBox[{"ffun", ",", "gfun"}], "]"}], ";", 
     RowBox[{"detset", "=", 
      RowBox[{"{", "}"}]}], ";", 
     RowBox[{"solfin", "=", 
      RowBox[{"{", "}"}]}], ";", 
     RowBox[{"zetak", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"kr", "^", "2"}], "-", "1"}], ")"}], 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"kr", "+", "2"}], ")"}], "/", "we"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"zetak2", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"zetak", "-", "1"}], ")"}], "/", 
       SuperscriptBox["\[Epsilon]", "2"]}]}], ";", 
     RowBox[{"s", "=", 
      FractionBox["\[CapitalDelta]k", 
       SuperscriptBox["\[Epsilon]", "2"]]}], ";", 
     RowBox[{"sols", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"c0", ",", "d0"}], "}"}], "/.", 
       RowBox[{"NSolve", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"2", "*", "s", "*", "c0"}], "\[VeryThinSpace]", "-", 
             RowBox[{"zetak2", "*", "d0"}], "+", 
             RowBox[{"g1", "*", "c0"}], "+", 
             RowBox[{"g2", "*", "d0"}], "+", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"\[Alpha]", "*", "c0"}], "+", 
                RowBox[{"\[Beta]", "*", "d0"}]}], ")"}], 
              RowBox[{"(", 
               RowBox[{
                SuperscriptBox["c0", "2"], "+", 
                SuperscriptBox["d0", "2"]}], ")"}]}]}], "==", "0"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"2", "*", "s", "*", "d0"}], "+", 
             RowBox[{"zetak2", "*", "c0"}], "\[VeryThinSpace]", "-", 
             RowBox[{"g3", "*", "c0"}], "-", 
             RowBox[{"g4", "*", "d0"}], "-", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"\[Beta]", "*", "c0"}], "-", 
                RowBox[{"\[Alpha]", "*", "d0"}]}], ")"}], 
              RowBox[{"(", 
               RowBox[{
                SuperscriptBox["c0", "2"], "+", 
                SuperscriptBox["d0", "2"]}], ")"}]}]}], "==", "0"}]}], "}"}], 
         ",", 
         RowBox[{"{", 
          RowBox[{"c0", ",", "d0"}], "}"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"jj", "=", "1"}], ",", 
       RowBox[{"jj", "<", 
        RowBox[{"Length", "[", "sols", "]"}]}], ",", 
       RowBox[{"jj", "++"}], ",", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Abs", "@", 
            RowBox[{"Re", "@", 
             RowBox[{
              RowBox[{"sols", "[", 
               RowBox[{"[", "jj", "]"}], "]"}], "[", 
              RowBox[{"[", "1", "]"}], "]"}]}]}], ">", "0"}], "&&", 
          RowBox[{
           RowBox[{"Abs", "@", 
            RowBox[{"Re", "@", 
             RowBox[{
              RowBox[{"sols", "[", 
               RowBox[{"[", "jj", "]"}], "]"}], "[", 
              RowBox[{"[", "2", "]"}], "]"}]}]}], ">", "0"}], "&&", 
          RowBox[{
           RowBox[{"Abs", "@", 
            RowBox[{"Im", "@", 
             RowBox[{
              RowBox[{"sols", "[", 
               RowBox[{"[", "jj", "]"}], "]"}], "[", 
              RowBox[{"[", "1", "]"}], "]"}]}]}], "==", "0"}]}], ",", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"solset", ",", 
           RowBox[{"sols", "[", 
            RowBox[{"[", "jj", "]"}], "]"}]}], "]"}]}], "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"ffun", "[", 
       RowBox[{"c0", ",", "d0"}], "]"}], "=", 
      RowBox[{"-", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", "*", "s", "*", "c0"}], "\[VeryThinSpace]", "-", 
         RowBox[{"zetak2", "*", "d0"}], "+", 
         RowBox[{"g1", "*", "c0"}], "+", 
         RowBox[{"g2", "*", "d0"}], "+", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"\[Alpha]", "*", "c0"}], "+", 
            RowBox[{"\[Beta]", "*", "d0"}]}], ")"}], 
          RowBox[{"(", 
           RowBox[{
            SuperscriptBox["c0", "2"], "+", 
            SuperscriptBox["d0", "2"]}], ")"}]}]}], ")"}]}]}], ";", "\n", 
     RowBox[{
      RowBox[{"gfun", "[", 
       RowBox[{"c0", ",", "d0"}], "]"}], "=", 
      RowBox[{"-", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", "*", "s", "*", "d0"}], "+", 
         RowBox[{"zetak2", "*", "c0"}], "\[VeryThinSpace]", "-", 
         RowBox[{"g3", "*", "c0"}], "-", 
         RowBox[{"g4", "*", "d0"}], "-", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"\[Beta]", "*", "c0"}], "-", 
            RowBox[{"\[Alpha]", "*", "d0"}]}], ")"}], 
          RowBox[{"(", 
           RowBox[{
            SuperscriptBox["c0", "2"], "+", 
            SuperscriptBox["d0", "2"]}], ")"}]}]}], ")"}]}]}], ";", 
     "\[IndentingNewLine]", 
