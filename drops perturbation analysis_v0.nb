           RowBox[{"realkl", "[", 
            RowBox[{"2", ",", "0"}], "]"}]}], "+", 
          RowBox[{
           RowBox[{"mkl", "[", 
            RowBox[{"2", ",", "1"}], "]"}], "*", 
           RowBox[{"realkl", "[", 
            RowBox[{"2", ",", "1"}], "]"}]}], "+", 
          RowBox[{
           RowBox[{"mkl", "[", 
            RowBox[{"3", ",", "0"}], "]"}], "*", 
           RowBox[{"realkl", "[", 
            RowBox[{"3", ",", "0"}], "]"}]}]}], ")"}], "*", 
        RowBox[{"realkl", "[", 
         RowBox[{"k", ",", "l"}], "]"}], "*", 
        RowBox[{"Sin", "[", "\[Theta]", "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Theta]", ",", "0", ",", "Pi"}], "}"}], ",", 
