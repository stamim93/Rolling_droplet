Cell[BoxData[
 RowBox[{
  RowBox[{"bkl1trans", "[", 
   RowBox[{
   "oh_", ",", "we_", ",", "\[Rho]1_", ",", "\[Rho]2_", ",", "\[Mu]1_", ",", 
    "\[Mu]2_", ",", "k_", ",", "l_"}], "]"}], ":=", 
  RowBox[{"(", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"kr", "=", 
      RowBox[{"number", " ", "of", " ", "resonance", " ", "mode"}]}], ",", 
     " ", 
     RowBox[{"e", ".", "g", "."}], ",", " ", 
     RowBox[{"kr", "=", "3"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"delta", "=", 
     FractionBox["oh", "we"]}], ";", "\[IndentingNewLine]", 
    RowBox[{"qk", "=", 
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"realklpt", "[", 
         RowBox[{"k", ",", "0", ",", "\[Theta]", ",", "\[CurlyPhi]"}], "]"}], 
        "*", 
        RowBox[{"realklpt", "[", 
         RowBox[{"k", ",", "l", ",", "\[Theta]", ",", "\[CurlyPhi]"}], "]"}], 
        "*", 
        RowBox[{"Sin", "[", "\[Theta]", "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Theta]", ",", "0", ",", "Pi"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[CurlyPhi]", ",", "0", ",", 
         RowBox[{"2", "Pi"}]}], "}"}]}], "]"}]}], ";", 
    RowBox[{"(*", 
     RowBox[{
     "factor", " ", "of", " ", "2", " ", "in", " ", "front", " ", "because", 
      " ", "of", " ", "the", " ", "inner", " ", "product", " ", "over", " ", 
      "hemisphere"}], "*)"}], "\[IndentingNewLine]", 
    RowBox[{"\[Zeta]k", "=", 
     SqrtBox[
      FractionBox[
       RowBox[{"k", 
        RowBox[{"(", 
         RowBox[{"k", "+", "1"}], ")"}], 
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["k", "2"], "+", "k", "-", "2"}], ")"}]}], 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"\[Rho]1", "*", 
           RowBox[{"(", 
            RowBox[{"k", "+", "1"}], ")"}]}], "+", 
          RowBox[{"\[Rho]2", "*", "k"}]}], ")"}], "we"}]]]}], ";", 
    RowBox[{"nk", "=", 
     RowBox[{
      FractionBox[
       RowBox[{
        RowBox[{"(", 
         RowBox[{"\[Rho]2", "-", "\[Rho]1"}], ")"}], "*", "k", "*", 
        RowBox[{"(", 
         RowBox[{"k", "+", "1"}], ")"}]}], 
       RowBox[{
        RowBox[{"\[Rho]1", 
         RowBox[{"(", 
          RowBox[{"k", "+", "1"}], ")"}]}], "+", 
        RowBox[{"\[Rho]2", "*", "k"}]}]], "*", 
      SqrtBox[
       FractionBox[
        RowBox[{
         RowBox[{"2", "k"}], "+", "1"}], 
        RowBox[{"4", "*", "Pi"}]]], "*", "qk"}]}], ";", 
    RowBox[{"gk", "=", 
     FractionBox[
      RowBox[{"k", 
       RowBox[{"(", 
        RowBox[{"k", "+", "1"}], ")"}]}], 
      RowBox[{
       RowBox[{"\[Rho]1", 
        RowBox[{"(", 
         RowBox[{"k", "+", "1"}], ")"}]}], "+", 
       RowBox[{"\[Rho]2", "*", "k"}]}]]}], ";", 
    RowBox[{"\[CapitalDelta]k", "=", 
     RowBox[{"delta", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"\[Mu]1", "*", 
         RowBox[{"(", 
          RowBox[{"k", "-", "1"}], ")"}]}], "+", 
        RowBox[{"\[Mu]2", "*", 
         RowBox[{"(", 
          RowBox[{"k", "+", "2"}], ")"}]}]}], ")"}], "*", "gk"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"m1k", "=", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"\[CapitalDelta]k", "==", "0"}], "&&", 
        RowBox[{"\[Zeta]k", "==", "1"}]}], ",", "0", ",", 
       FractionBox[
        RowBox[{"nk", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "1"}], "+", "\[Zeta]k"}], ")"}]}], 
        RowBox[{
         RowBox[{"4", " ", 
          SuperscriptBox["\[CapitalDelta]k", "2"]}], "+", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "1"}], "+", "\[Zeta]k"}], ")"}], "2"]}]]}], "]"}]}], 
    ";", "\[IndentingNewLine]", 
    RowBox[{"m2k", "=", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"\[CapitalDelta]k", "==", "0"}], "&&", 
        RowBox[{"\[Zeta]k", "==", "1"}]}], ",", "0", ",", 
       FractionBox[
        RowBox[{"2", " ", "\[CapitalDelta]k", "*", "nk"}], 
        RowBox[{
         RowBox[{"4", " ", 
          SuperscriptBox["\[CapitalDelta]k", "2"]}], "+", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "1"}], "+", "\[Zeta]k"}], ")"}], "2"]}]]}], "]"}]}], 
    ";", 
    RowBox[{"(*", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"icsol", "=", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"ckl", ",", "dkl"}], "}"}], "/.", 
        RowBox[{"Flatten", "[", 
         RowBox[{"Solve", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  SuperscriptBox["\[ExponentialE]", 
                   RowBox[{
                    RowBox[{"-", "t"}], " ", 
                    RowBox[{"(", 
                    RowBox[{"\[CapitalDelta]k", "+", 
                    SqrtBox[
                    RowBox[{
                    SuperscriptBox["\[CapitalDelta]k", "2"], "-", 
                    SuperscriptBox["\[Zeta]k", "2"]}]]}], ")"}]}]], " ", 
                  RowBox[{"(", 
                   RowBox[{"ckl", "+", 
                    RowBox[{"dkl", " ", 
                    SuperscriptBox["\[ExponentialE]", 
                    RowBox[{"2", " ", "t", " ", 
                    SqrtBox[
                    RowBox[{
                    SuperscriptBox["\[CapitalDelta]k", "2"], "-", 
                    SuperscriptBox["\[Zeta]k", "2"]}]]}]]}]}], ")"}]}], "+", 
                 RowBox[{"m1k", "*", 
                  RowBox[{"Cos", "[", "t", "]"}]}], "+", 
                 RowBox[{"m2k", "*", 
                  RowBox[{"Sin", "[", "t", "]"}]}]}], "/.", 
                RowBox[{"t", "->", "0"}]}], ")"}], "==", "ic1"}], ",", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"D", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{
                    SuperscriptBox["\[ExponentialE]", 
                    RowBox[{
                    RowBox[{"-", "t"}], " ", 
                    RowBox[{"(", 
                    RowBox[{"\[CapitalDelta]k", "+", 
                    SqrtBox[
                    RowBox[{
                    SuperscriptBox["\[CapitalDelta]k", "2"], "-", 
                    SuperscriptBox["\[Zeta]k", "2"]}]]}], ")"}]}]], " ", 
                    RowBox[{"(", 
                    RowBox[{"ckl", "+", 
                    RowBox[{"dkl", " ", 
                    SuperscriptBox["\[ExponentialE]", 
                    RowBox[{"2", " ", "t", " ", 
                    SqrtBox[
                    RowBox[{
                    SuperscriptBox["\[CapitalDelta]k", "2"], "-", 
                    SuperscriptBox["\[Zeta]k", "2"]}]]}]]}]}], ")"}]}], "+", 
                   RowBox[{"m1k", "*", 
                    RowBox[{"Cos", "[", "t", "]"}]}], "+", 
                   RowBox[{"m2k", "*", 
                    RowBox[{"Sin", "[", "t", "]"}]}]}], ",", "t"}], "]"}], "/.", 
                RowBox[{"t", "->", "0"}]}], ")"}], "==", "ic2"}]}], "}"}], 
           ",", 
           RowBox[{"{", 
            RowBox[{"ckl", ",", "dkl"}], "}"}]}], "]"}], "]"}]}]}], ";"}], 
     "*)"}], "\[IndentingNewLine]", 
    RowBox[{"bkl1ivpsol", "=", 
     RowBox[{
      RowBox[{"m1k", "*", 
       RowBox[{"Sin", "[", "t", "]"}]}], "+", 
      RowBox[{"m2k", "*", 
       RowBox[{"Cos", "[", "t", "]"}]}]}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"bkl1l2norm", "=", 
     RowBox[{
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"Integrate", "[", 
          RowBox[{
           SuperscriptBox[
            RowBox[{"(", "bkl1ivpsol", ")"}], "2"], ",", 
           RowBox[{"{", 
            RowBox[{"t", ",", "0", ",", 
             RowBox[{"2", "Pi"}]}], "}"}]}], "]"}], ")"}], 
        RowBox[{"1", "/", "2"}]], "/", 
       RowBox[{"(", 
        RowBox[{"2", "Pi"}], ")"}]}], "//", "Chop"}]}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"bkl0amp", "=", 
     FractionBox[
      RowBox[{"2", " ", 
       RowBox[{"(", 
        RowBox[{"1", "+", "k"}], ")"}], " ", "qk", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", " ", "\[CapitalDelta]k", " ", 
          RowBox[{"Cos", "[", "t", "]"}]}], "+", 
         RowBox[{"Sin", "[", "t", "]"}], "-", 
         RowBox[{
          SuperscriptBox["\[Zeta]k", "2"], " ", 
          RowBox[{"Sin", "[", "t", "]"}]}]}], ")"}]}], 
      RowBox[{"1", "+", 
       RowBox[{"4", " ", 
        SuperscriptBox["\[CapitalDelta]k", "2"]}], "-", 
       RowBox[{"2", " ", 
        SuperscriptBox["\[Zeta]k", "2"]}], "+", 
       SuperscriptBox["\[Zeta]k", "4"]}]]}], "*)"}], 
   RowBox[{"(*", 
    RowBox[{"before", " ", "forcing", " ", "sign", " ", "correction"}], 
    "*)"}], 
   RowBox[{"(*", 
    RowBox[{"after", " ", "forcing", " ", "sign", " ", "correction"}], "*)"}],
    "\[IndentingNewLine]", ")"}]}]], "Input",
 InitializationCell->True,
