Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"bkl0fun", "[", 
    RowBox[{
    "oh_", ",", "\[Rho]1_", ",", "\[Rho]2_", ",", "\[Mu]1_", ",", "\[Mu]2_", 
     ",", "k_", ",", "l_", ",", "m_", ",", "n_"}], "]"}], ":=", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"Clear", "[", 
      RowBox[{"c0", ",", "d0", ",", "m1k", ",", "m2k"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"wem", "=", 
      FractionBox[
       RowBox[{"m", 
        RowBox[{"(", 
         RowBox[{"m", "+", "1"}], ")"}], 
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["m", "2"], "+", "m", "-", "2"}], ")"}]}], 
       RowBox[{
        RowBox[{"\[Rho]1", "*", 
         RowBox[{"(", 
          RowBox[{"m", "+", "1"}], ")"}]}], "+", 
        RowBox[{"\[Rho]2", "*", "m"}]}]]}], ";", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"kr", "=", 
        RowBox[{"number", " ", "of", " ", "resonance", " ", "mode"}]}], ",", 
       " ", 
       RowBox[{"e", ".", "g", "."}], ",", " ", 
       RowBox[{"kr", "=", "3"}]}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"delta", "=", 
      FractionBox["oh", "wem"]}], ";", "\[IndentingNewLine]", 
     RowBox[{"qk", "=", 
      RowBox[{"Integrate", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"realklpt", "[", 
          RowBox[{"k", ",", "0", ",", "\[Theta]", ",", "\[CurlyPhi]"}], "]"}],
          "*", 
         RowBox[{"realklpt", "[", 
          RowBox[{"k", ",", "l", ",", "\[Theta]", ",", "\[CurlyPhi]"}], "]"}],
          "*", 
         RowBox[{"Sin", "[", "\[Theta]", "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"\[Theta]", ",", "0", ",", "Pi"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\[CurlyPhi]", ",", "0", ",", 
          RowBox[{"2", "Pi"}]}], "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Zeta]k", "=", 
      SqrtBox[
       FractionBox[
        RowBox[{"k", 
         RowBox[{"(", 
          RowBox[{"k", "+", "1"}], ")"}], 
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["k", "2"], "+", "k", "-", "2"}], ")"}]}], 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"\[Rho]1", "*", 
            RowBox[{"(", 
             RowBox[{"k", "+", "1"}], ")"}]}], "+", 
           RowBox[{"\[Rho]2", "*", "k"}]}], ")"}], "wem"}]]]}], ";", 
     RowBox[{"nk", "=", 
      RowBox[{
       FractionBox[
        RowBox[{
         RowBox[{"(", 
          RowBox[{"\[Rho]1", "-", "\[Rho]2"}], ")"}], "*", "k", "*", 
         RowBox[{"(", 
          RowBox[{"k", "+", "1"}], ")"}]}], 
        RowBox[{
         RowBox[{"\[Rho]1", 
          RowBox[{"(", 
           RowBox[{"k", "+", "1"}], ")"}]}], "+", 
         RowBox[{"\[Rho]2", "*", "k"}]}]], "*", 
       SqrtBox[
        FractionBox[
         RowBox[{
          RowBox[{"2", "k"}], "+", "1"}], 
         RowBox[{"4", "*", "Pi"}]]], "*", "qk"}]}], ";", 
     RowBox[{"fk", "=", 
      FractionBox[
       RowBox[{"k", 
        RowBox[{"(", 
         RowBox[{"k", "+", "1"}], ")"}]}], 
       RowBox[{
        RowBox[{"\[Rho]1", 
         RowBox[{"(", 
          RowBox[{"k", "+", "1"}], ")"}]}], "+", 
        RowBox[{"\[Rho]2", "*", "k"}]}]]}], ";", 
     RowBox[{"\[CapitalDelta]k", "=", 
      RowBox[{"delta", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"\[Mu]1", "*", 
          RowBox[{"(", 
           RowBox[{"k", "-", "1"}], ")"}]}], "+", 
         RowBox[{"\[Mu]2", "*", 
          RowBox[{"(", 
           RowBox[{"k", "+", "2"}], ")"}]}]}], ")"}], "*", "fk"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"m1k", "=", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"\[CapitalDelta]k", "==", "0"}], "&&", 
           RowBox[{"\[Zeta]k", "==", "1"}]}], ",", "0", ",", 
          FractionBox[
           RowBox[{"nk", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", "1"}], "+", "\[Zeta]k"}], ")"}]}], 
           RowBox[{
            RowBox[{"4", " ", 
             SuperscriptBox["\[CapitalDelta]k", "2"]}], "+", 
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{
               RowBox[{"-", "1"}], "+", "\[Zeta]k"}], ")"}], "2"]}]]}], 
         "]"}]}], ";"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"m2k", "=", 
      FractionBox[
       RowBox[{"nk", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "1"}], "+", 
          SuperscriptBox["\[Zeta]k", "2"]}], ")"}]}], 
       RowBox[{
        RowBox[{"4", " ", 
         SuperscriptBox["\[CapitalDelta]k", "2"]}], "+", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "1"}], "+", 
           SuperscriptBox["\[Zeta]k", "2"]}], ")"}], "2"]}]]}], ";", 
     RowBox[{"m1k", "=", 
      FractionBox[
       RowBox[{
        RowBox[{"-", "2"}], " ", "\[CapitalDelta]k", "*", "nk"}], 
       RowBox[{
        RowBox[{"4", " ", 
         SuperscriptBox["\[CapitalDelta]k", "2"]}], "+", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "1"}], "+", 
           SuperscriptBox["\[Zeta]k", "2"]}], ")"}], "2"]}]]}], ";", 
     RowBox[{"(*", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"m2k", "=", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"\[CapitalDelta]k", "==", "0"}], "&&", 
           RowBox[{"\[Zeta]k", "==", "1"}]}], ",", "0", ",", 
          FractionBox[
           RowBox[{"2", " ", "\[CapitalDelta]k", "*", "nk"}], 
           RowBox[{
            RowBox[{"4", " ", 
             SuperscriptBox["\[CapitalDelta]k", "2"]}], "+", 
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{
               RowBox[{"-", "1"}], "+", "\[Zeta]k"}], ")"}], "2"]}]]}], 
         "]"}]}], ";"}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"k", "==", "kr"}], ",", 
         RowBox[{"\[Zeta]k", "=", "1"}]}], "]"}], ";"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"bkl0amp", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"k", "==", "m"}], "&&", 
         RowBox[{"l", "==", "n"}]}], ",", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"cmn", "*", 
            RowBox[{"Cos", "[", 
             RowBox[{"\[Zeta]k", "*", "t"}], "]"}]}], "+", 
           RowBox[{"dmn", "*", 
            RowBox[{"Sin", "[", 
             RowBox[{"\[Zeta]k", "*", "t"}], "]"}]}]}], ")"}], "+", 
         RowBox[{"m1k", "*", 
          RowBox[{"Cos", "[", "t", "]"}]}], "+", 
         RowBox[{"m2k", "*", 
          RowBox[{"Sin", "[", "t", "]"}]}]}], ",", 
        RowBox[{
         RowBox[{"m1k", "*", 
          RowBox[{"Cos", "[", "t", "]"}]}], "+", 
         RowBox[{"m2k", "*", 
          RowBox[{"Sin", "[", "t", "]"}]}]}]}], "]"}]}]}], ")"}]}], 
  RowBox[{"(*", 
   RowBox[{
   "leading", " ", "order", " ", "amplitude", " ", "of", " ", "different", 
    " ", "modes", " ", "at", " ", "the", " ", "resonance", " ", "frequency", 
    " ", "kr"}], "*)"}], "\[IndentingNewLine]"}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.961697693435732*^9, 3.9616976938879747`*^9}, {
   3.961703217550271*^9, 3.96170332680445*^9}, {3.962144618056329*^9, 
