      RowBox[{
      "oh", ",", "\[Rho]1", ",", "\[Rho]2", ",", "\[Mu]1", ",", "\[Mu]2", ",",
        "kr", ",", "lr"}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"lkl1", "=", 
     RowBox[{"l211f", "[", 
      RowBox[{
      "oh", ",", "\[Rho]1", ",", "\[Rho]2", ",", "\[Mu]1", ",", "\[Mu]2", ",",
        "kr", ",", "lr"}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"kkl1t", "=", 
     RowBox[{"D", "[", 
      RowBox[{"kkl1", ",", "t"}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"lkl1t", "=", 
     RowBox[{"D", "[", 
      RowBox[{"lkl1", ",", "t"}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"b020", "=", 
     RowBox[{"bkl0fun", "[", 
      RowBox[{
      "oh", ",", "\[Rho]1", ",", "\[Rho]2", ",", "\[Mu]1", ",", "\[Mu]2", ",",
        "2", ",", "0", ",", "kr", ",", "lr"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"b021", "=", 
     RowBox[{"bkl0fun", "[", 
      RowBox[{
      "oh", ",", "\[Rho]1", ",", "\[Rho]2", ",", "\[Mu]1", ",", "\[Mu]2", ",",
        "2", ",", "1", ",", "kr", ",", "lr"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
