          RowBox[{"Cos", "[", "t", "]"}]}], "+", 
         RowBox[{"2", " ", "d", " ", 
          RowBox[{"Sin", "[", "t", "]"}]}]}], ")"}]}], 
      RowBox[{"1", "+", 
       RowBox[{"4", " ", 
        SuperscriptBox["d", "2"]}], "-", 
