        "3", ",", "0", ",", "kr", ",", "lr"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"wer", "=", 
     FractionBox[
      RowBox[{"kr", 
       RowBox[{"(", 
        RowBox[{"kr", "+", "1"}], ")"}], 
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["kr", "2"], "+", "kr", "-", "2"}], ")"}]}], 
      RowBox[{
       RowBox[{"\[Rho]1", "*", 
        RowBox[{"(", 
         RowBox[{"kr", "+", "1"}], ")"}]}], "+", 
       RowBox[{"\[Rho]2", "*", "kr"}]}]]}], ";", 
    RowBox[{"(*", 
     RowBox[{
     "weber", " ", "number", " ", "for", " ", "the", " ", "resonance", " ", 
