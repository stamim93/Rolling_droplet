Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"DSolve", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"x", "''"}], "[", "t", "]"}], "+", 
     RowBox[{"2", "*", "mu", "*", 
      RowBox[{
       RowBox[{"x", "'"}], "[", "t", "]"}]}], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        FractionBox["1", "4"], "+", 
        SuperscriptBox["mu", "2"]}], ")"}], "*", 
      RowBox[{"x", "[", "t", "]"}]}]}], "==", 
    RowBox[{
     RowBox[{
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{
        RowBox[{"-", "mu"}], " ", "t"}]], " ", "a", " ", 
      RowBox[{"Cos", "[", 
       FractionBox["t", "2"], "]"}]}], "+", 
     RowBox[{
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{
        RowBox[{"-", "mu"}], " ", "t"}]], " ", "b", " ", 
      RowBox[{"Sin", "[", 
       FractionBox["t", "2"], "]"}]}]}]}], ",", 
