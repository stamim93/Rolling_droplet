Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"DSolve", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"x", "''"}], "[", "t", "]"}], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox["z", "2"], "-", 
        SuperscriptBox["d", "2"]}], ")"}], "*", 
      RowBox[{"x", "[", "t", "]"}]}]}], "==", 
    RowBox[{"f", "*", 
     SuperscriptBox["E", 
      RowBox[{"d", "*", "t"}]], 
     RowBox[{"Cos", "[", "t", "]"}]}]}], ",", 
   RowBox[{"x", "[", "t", "]"}], ",", "t"}], "]"}]], "Input",
 CellChangeTimes->{{3.980889114057337*^9, 3.980889140829328*^9}, {
  3.980889244587892*^9, 3.980889250552925*^9}},
 CellLabel->
  "In[1373]:=",ExpressionUUID->"eb25eca7-990e-4b70-8fa1-ab46c98f1cbe"],

