Cell[BoxData[
 RowBox[{
  RowBox[{"b211", "[", 
   RowBox[{
   "oh_", ",", "\[Rho]1_", ",", "\[Rho]2_", ",", "\[Mu]1_", ",", "\[Mu]2_", 
    ",", "kr_", ",", "lr_"}], "]"}], ":=", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"Clear", "[", 
     RowBox[{
     "f1", ",", "f2", ",", "f3", ",", "f4", ",", "f5", ",", 
      "\[CapitalDelta]k", ",", "k", ",", "eta1", ",", "b020", ",", "b021", 
      ",", "b030", ",", "forcing211"}], "]"}], ";", 
    RowBox[{"k", "=", "2"}], ";", 
    RowBox[{"l", "=", "1"}], ";", "\[IndentingNewLine]", 
    RowBox[{"eta1", "=", 
     RowBox[{
      RowBox[{"b020", "*", 
       RowBox[{"realkl", "[", 
        RowBox[{"2", ",", "0"}], "]"}]}], "+", 
      RowBox[{
       RowBox[{"(", "b021", ")"}], "*", 
       RowBox[{"realkl", "[", 
        RowBox[{"2", ",", "1"}], "]"}]}], "+", 
      RowBox[{"b030", "*", 
       RowBox[{"realkl", "[", 
        RowBox[{"3", ",", "0"}], "]"}]}]}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"tkl1", "=", 
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{"eta1", "*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"mkl", "[", 
