Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"x", "[", "t", "]"}], "\[Rule]", 
    RowBox[{
     RowBox[{
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{
        RowBox[{"-", "mu"}], " ", "t"}]], " ", 
      TemplateBox[{"2"},
       "C"], " ", 
      RowBox[{"Cos", "[", 
       FractionBox["t", "2"], "]"}]}], "+", 
     RowBox[{
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{
        RowBox[{"-", "mu"}], " ", "t"}]], " ", 
      TemplateBox[{"1"},
       "C"], " ", 
      RowBox[{"Sin", "[", 
       FractionBox["t", "2"], "]"}]}], "+", 
     RowBox[{
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{
        RowBox[{"-", "mu"}], " ", "t"}]], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "b"}], " ", "t", " ", 
         RowBox[{"Cos", "[", 
          FractionBox["t", "2"], "]"}]}], "+", 
        RowBox[{"2", " ", "a", " ", 
         SuperscriptBox[
          RowBox[{"Cos", "[", 
           FractionBox["t", "2"], "]"}], "3"]}], "+", 
        RowBox[{"a", " ", "t", " ", 
         RowBox[{"Sin", "[", 
          FractionBox["t", "2"], "]"}]}], "-", 
        RowBox[{"2", " ", "b", " ", 
         SuperscriptBox[
          RowBox[{"Cos", "[", 
           FractionBox["t", "2"], "]"}], "2"], " ", 
         RowBox[{"Sin", "[", 
          FractionBox["t", "2"], "]"}]}], "+", 
        RowBox[{"b", " ", 
         RowBox[{"Cos", "[", 
          FractionBox["t", "2"], "]"}], " ", 
         RowBox[{"Sin", "[", "t", "]"}]}], "+", 
        RowBox[{"a", " ", 
         RowBox[{"Sin", "[", 
          FractionBox["t", "2"], "]"}], " ", 
         RowBox[{"Sin", "[", "t", "]"}]}]}], ")"}]}]}]}], "}"}], 
  "}"}]], "Output",
