Cell[BoxData[
 RowBox[{
  RowBox[{"magkl1mn2", "[", 
   RowBox[{
   "oh_", ",", "\[Rho]1_", ",", "\[Rho]2_", ",", "\[Mu]1_", ",", "\[Mu]2_", 
    ",", "k_", ",", "l_", ",", "m_"}], "]"}], ":=", 
  RowBox[{"(", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"wem", "=", 
     FractionBox[
      RowBox[{"m", 
       RowBox[{"(", 
        RowBox[{"m", "+", "1"}], ")"}], 
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["m", "2"], "+", "m", "-", "2"}], ")"}]}], 
      RowBox[{
       RowBox[{"\[Rho]1", "*", 
        RowBox[{"(", 
         RowBox[{"m", "+", "1"}], ")"}]}], "+", 
       RowBox[{"\[Rho]2", "*", "m"}]}]]}], ";", 
    RowBox[{"delta", "=", 
     FractionBox["oh", "wem"]}], ";", 
    RowBox[{"\[Zeta]k", "=", 
     SqrtBox[
      FractionBox[
       RowBox[{"k", 
        RowBox[{"(", 
         RowBox[{"k", "+", "1"}], ")"}], 
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["k", "2"], "+", "k", "-", "2"}], ")"}]}], 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"\[Rho]1", "*", 
           RowBox[{"(", 
            RowBox[{"k", "+", "1"}], ")"}]}], "+", 
          RowBox[{"\[Rho]2", "*", "k"}]}], ")"}], "wem"}]]]}], ";", 
    RowBox[{"fk", "=", 
     FractionBox[
      RowBox[{"k", 
       RowBox[{"(", 
        RowBox[{"k", "+", "1"}], ")"}]}], 
      RowBox[{
       RowBox[{"\[Rho]1", 
        RowBox[{"(", 
         RowBox[{"k", "+", "1"}], ")"}]}], "+", 
       RowBox[{"\[Rho]2", "*", "k"}]}]]}], ";", 
    RowBox[{"\[CapitalDelta]k", "=", 
     RowBox[{"delta", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"\[Mu]1", "*", 
         RowBox[{"(", 
          RowBox[{"k", "-", "1"}], ")"}]}], "+", 
        RowBox[{"\[Mu]2", "*", 
         RowBox[{"(", 
          RowBox[{"k", "+", "2"}], ")"}]}]}], ")"}], "*", "fk"}]}], ";", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"qkl", "=", 
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Cos", "[", "\[Theta]", "]"}], "*", 
        RowBox[{"realklpt", "[", 
         RowBox[{"k", ",", "l", ",", "\[Theta]", ",", "\[CurlyPhi]"}], "]"}], 
        "*", 
        RowBox[{"Sin", "[", "\[Theta]", "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Theta]", ",", "0", ",", 
         RowBox[{"Pi", "/", "2"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[CurlyPhi]", ",", "0", ",", 
         RowBox[{"2", "Pi"}]}], "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
    
    RowBox[{"nk", "=", 
     FractionBox[
      RowBox[{
       RowBox[{"(", 
        RowBox[{"\[Rho]2", "-", "\[Rho]1"}], ")"}], "*", "k", "*", 
       RowBox[{"(", 
        RowBox[{"k", "+", "1"}], ")"}]}], 
      RowBox[{
       RowBox[{"\[Rho]1", 
        RowBox[{"(", 
         RowBox[{"k", "+", "1"}], ")"}]}], "+", 
       RowBox[{"\[Rho]2", "*", "k"}]}]]}], ";", "\[IndentingNewLine]", 
    RowBox[{"magkl", "=", 
     FractionBox[
      RowBox[{"2", "nk", "*", 
       RowBox[{"Abs", "[", "qkl", "]"}]}], 
      SqrtBox[
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"1", "-", 
           SuperscriptBox["\[Zeta]k", "2"]}], ")"}], "2"], "+", 
        RowBox[{"4", "*", 
         SuperscriptBox["\[CapitalDelta]k", "2"]}]}]]]}]}]}]}]], "Input",Expre\
ssionUUID->"135bfef0-f35f-490c-b4f0-65de9c16b589"],

