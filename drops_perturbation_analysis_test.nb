Cell[BoxData[
 RowBox[{
  RowBox[{"realklpt", "[", 
   RowBox[{"k_", ",", "l_", ",", "a_", ",", "b_"}], "]"}], ":=", 
  RowBox[{"Piecewise", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          SqrtBox["2"], ")"}], "*", 
         RowBox[{"ComplexExpand", "[", 
          RowBox[{"Re", "[", 
           RowBox[{"SphericalHarmonicY", "[", 
            RowBox[{"k", ",", "l", ",", "a", ",", "b"}], "]"}], "]"}], 
          "]"}]}], "//", "FullSimplify"}], ",", 
       RowBox[{"l", ">", "0"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"SphericalHarmonicY", "[", 
        RowBox[{"k", ",", "0", ",", "a", ",", "0"}], "]"}], ",", 
       RowBox[{"l", "==", "0"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          SqrtBox["2"], ")"}], "*", 
         RowBox[{"ComplexExpand", "[", 
          RowBox[{"Im", "[", 
           RowBox[{"SphericalHarmonicY", "[", 
            RowBox[{"k", ",", "l", ",", "a", ",", "b"}], "]"}], "]"}], 
          "]"}]}], "//", "FullSimplify"}], ",", 
       RowBox[{"l", "<", "0"}]}], "}"}]}], "}"}], "]"}]}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.981219612308022*^9, 3.981219620620717*^9}, {
  3.98132803889283*^9, 3.981328045251994*^9}, {3.982852969395705*^9, 
  3.982852974561432*^9}},
