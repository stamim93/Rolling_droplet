Cell[BoxData[
 RowBox[{"\[Zeta]k", "=", 
  SqrtBox[
   FractionBox[
    RowBox[{"k", 
     RowBox[{"(", 
      RowBox[{"k", "+", "1"}], ")"}], 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["k", "2"], "+", "k", "-", "2"}], ")"}]}], 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"\[Rho]1", "*", 
        RowBox[{"(", 
         RowBox[{"k", "+", "1"}], ")"}]}], "+", 
       RowBox[{"\[Rho]2", "*", "k"}]}], ")"}], "wem"}]]]}]], "Input",
 CellChangeTimes->{3.985630157184876*^9},
 CellLabel->
  "In[134]:=",ExpressionUUID->"ba204b81-7db6-40a6-8421-836cdaedb840"],

Cell[BoxData[
 FractionBox[
  SqrtBox[
   FractionBox[
    RowBox[{"k", " ", 
     RowBox[{"(", 
      RowBox[{"1", "+", "k"}], ")"}], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "2"}], "+", "k", "+", 
       SuperscriptBox["k", "2"]}], ")"}]}], 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "+", "k"}], ")"}], " ", "\[Rho]1"}], "+", 
     RowBox[{"k", " ", "\[Rho]2"}]}]]], 
  RowBox[{"2", " ", 
