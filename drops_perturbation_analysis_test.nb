               FractionBox[
                RowBox[{"2", " ", 
                 RowBox[{"(", 
                  RowBox[{"1", "+", "k"}], ")"}], " ", "qkl", " ", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"2", " ", "\[CapitalDelta]k", " ", 
                    RowBox[{"Cos", "[", "t", "]"}]}], "+", 
                   RowBox[{"Sin", "[", "t", "]"}], "-", 
                   RowBox[{
                    SuperscriptBox["\[Zeta]k", "2"], " ", 
                    RowBox[{"Sin", "[", "t", "]"}]}]}], ")"}]}], 
                RowBox[{"1", "+", 
                 RowBox[{"4", " ", 
                  SuperscriptBox["\[CapitalDelta]k", "2"]}], "-", 
                 RowBox[{"2", " ", 
                  SuperscriptBox["\[Zeta]k", "2"]}], "+", 
