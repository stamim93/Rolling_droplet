Cell[BoxData[
 RowBox[{
  FractionBox[
   RowBox[{"m", 
    RowBox[{"(", 
     RowBox[{"m", "+", "1"}], ")"}], 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["m", "2"], "+", "m", "-", "2"}], ")"}]}], 
   RowBox[{
    RowBox[{"\[Rho]1", "*", 
