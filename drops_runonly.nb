Cell[BoxData[
 RowBox[{
  RowBox[{"realklpt", "[", 
   RowBox[{"k_", ",", "l_", ",", "a_", ",", "b_"}], "]"}], ":=", 
  RowBox[{"Piecewise", "[", 
   RowBox[{"{", 
