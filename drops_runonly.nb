          RowBox[{"k", "+", "1"}], ")"}]}], "+", 
        RowBox[{"\[Rho]2", "*", "k"}]}]]}], ";", 
     RowBox[{"\[CapitalDelta]k", "=", 
      RowBox[{"delta", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"\[Mu]1", "*", 
          RowBox[{"(", 
           RowBox[{"k", "-", "1"}], ")"}]}], "+", 
         RowBox[{"\[Mu]2", "*", 
          RowBox[{"(", 
           RowBox[{"k", "+", "2"}], ")"}]}]}], ")"}], "*", "fk"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"m1k", "=", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"\[CapitalDelta]k", "==", "0"}], "&&", 
