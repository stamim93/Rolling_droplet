               RowBox[{"-", "1"}], "+", "\[Zeta]k"}], ")"}], "2"]}]]}], 
         "]"}]}], ";"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"bkl0amp", "=", 
      RowBox[{"plf", "=", 
