Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"bkl1fun", "[", 
    RowBox[{
    "oh_", ",", "bo_", ",", "\[Rho]1_", ",", "\[Rho]2_", ",", "\[Mu]1_", ",", 
     "\[Mu]2_", ",", "k_", ",", "l_", ",", "m_", ",", "n_"}], "]"}], ":=", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"Clear", "[", 
      RowBox[{"c0", ",", "d0", ",", "m1k", ",", "m2k"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"wem", "=", 
      FractionBox[
       RowBox[{"m", 
        RowBox[{"(", 
         RowBox[{"m", "+", "1"}], ")"}], 
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["m", "2"], "+", "m", "-", "2"}], ")"}]}], 
       RowBox[{
        RowBox[{"\[Rho]1", "*", 
         RowBox[{"(", 
          RowBox[{"m", "+", "1"}], ")"}]}], "+", 
        RowBox[{"\[Rho]2", "*", "m"}]}]]}], ";", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"kr", "=", 
        RowBox[{"number", " ", "of", " ", "resonance", " ", "mode"}]}], ",", 
       " ", 
       RowBox[{"e", ".", "g", "."}], ",", " ", 
       RowBox[{"kr", "=", "3"}]}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"delta", "=", 
      FractionBox["oh", "wem"]}], ";", 
     RowBox[{"gg", "=", 
      FractionBox["bo", "wem"]}], ";", "\[IndentingNewLine]", 
     RowBox[{"rhoj", "=", 
      RowBox[{"\[Rho]1", "-", "\[Rho]2"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"fk", "=", 
      FractionBox[
       RowBox[{"k", 
        RowBox[{"(", 
         RowBox[{"k", "+", "1"}], ")"}]}], 
       RowBox[{
        RowBox[{"\[Rho]1", 
         RowBox[{"(", 
          RowBox[{"k", "+", "1"}], ")"}]}], "+", 
        RowBox[{"\[Rho]2", "*", "k"}]}]]}], ";", "\[IndentingNewLine]", 
     RowBox[{"deltak", "=", 
      RowBox[{"delta", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"\[Mu]1", "*", 
          RowBox[{"(", 
           RowBox[{"k", "-", "1"}], ")"}]}], "+", 
         RowBox[{"\[Mu]2", "*", 
          RowBox[{"(", 
           RowBox[{"k", "+", "2"}], ")"}]}]}], ")"}], "*", "fk"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"zetak", "=", 
      SqrtBox[
       FractionBox[
        RowBox[{"k", 
         RowBox[{"(", 
          RowBox[{"k", "+", "1"}], ")"}], 
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["k", "2"], "+", "k", "-", "2"}], ")"}]}], 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"\[Rho]1", "*", 
            RowBox[{"(", 
             RowBox[{"k", "+", "1"}], ")"}]}], "+", 
           RowBox[{"\[Rho]2", "*", "k"}]}], ")"}], "wem"}]]]}], ";", 
     RowBox[{"nk", "=", 
      FractionBox[
       RowBox[{
        RowBox[{"(", 
         RowBox[{"\[Rho]1", "-", "\[Rho]2"}], ")"}], "*", "k", "*", 
        RowBox[{"(", 
         RowBox[{"k", "+", "1"}], ")"}]}], 
       RowBox[{
        RowBox[{"\[Rho]1", 
         RowBox[{"(", 
          RowBox[{"k", "+", "1"}], ")"}]}], "+", 
        RowBox[{"\[Rho]2", "*", "k"}]}]]}], ";", 
     RowBox[{"fk", "=", 
      FractionBox[
       RowBox[{"k", 
        RowBox[{"(", 
         RowBox[{"k", "+", "1"}], ")"}]}], 
       RowBox[{
        RowBox[{"\[Rho]1", 
