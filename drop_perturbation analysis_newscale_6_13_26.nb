   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          SqrtBox["2"], ")"}], "*", 
         RowBox[{"ComplexExpand", "[", 
          RowBox[{"Re", "[", 
           RowBox[{"SphericalHarmonicY", "[", 
            RowBox[{"k", ",", "l", ",", "a", ",", "b"}], "]"}], "]"}], 
          "]"}]}], "//", "FullSimplify"}], ",", 
       RowBox[{"l", ">", "0"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"SphericalHarmonicY", "[", 
        RowBox[{"k", ",", "0", ",", "a", ",", "0"}], "]"}], ",", 
       RowBox[{"l", "==", "0"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          SqrtBox["2"], ")"}], "*", 
         RowBox[{"ComplexExpand", "[", 
          RowBox[{"Im", "[", 
           RowBox[{"SphericalHarmonicY", "[", 
            RowBox[{"k", ",", "l", ",", "a", ",", "b"}], "]"}], "]"}], 
          "]"}]}], "//", "FullSimplify"}], ",", 
       RowBox[{"l", "<", "0"}]}], "}"}]}], "}"}], "]"}]}]], "Input",
