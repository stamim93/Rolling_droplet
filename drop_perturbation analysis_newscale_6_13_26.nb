Cell[BoxData[
 RowBox[{
  RowBox[{"epssol", "[", 
   RowBox[{"\[Rho]1_", ",", "\[Rho]2_", ",", "m_", ",", "we_"}], "]"}], ":=", 
  
  RowBox[{"(", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"wem", "=", 
     FractionBox[
      RowBox[{"m", 
       RowBox[{"(", 
        RowBox[{"m", "+", "1"}], ")"}], 
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["m", "2"], "+", "m", "-", "2"}], ")"}]}], 
      RowBox[{
       RowBox[{"\[Rho]1", "*", 
        RowBox[{"(", 
         RowBox[{"m", "+", "1"}], ")"}]}], "+", 
       RowBox[{"\[Rho]2", "*", "m"}]}]]}], ";", "\[IndentingNewLine]", 
    RowBox[{"zetak", "=", 
     RowBox[{"wem", "/", "we"}]}], ";", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"allsol", "=", 
     RowBox[{"Flatten", "[", 
      RowBox[{"Join", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[Epsilon]", "/.", 
          RowBox[{"Solve", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"zetak", "-", "1", "-", 
              RowBox[{
               SuperscriptBox["\[Epsilon]", "2"], "*", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"1", "/", "2"}], ")"}], " ", 
                 RowBox[{"(", 
                  RowBox[{"g2", "+", "g3", "-", 
                   RowBox[{"\[Sqrt]", 
                    RowBox[{"(", 
                    RowBox[{
                    SuperscriptBox[
                    RowBox[{"(", 
                    RowBox[{"g2", "-", "g3"}], ")"}], "2"], "+", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"4", " ", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"2", " ", "\[CapitalDelta]k"}], "+", 
                    RowBox[{"g1", " ", 
                    SuperscriptBox["\[Epsilon]", "2"]}]}], ")"}], " ", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"-", "2"}], " ", "\[CapitalDelta]k"}], "+", 
                    RowBox[{"g4", " ", 
                    SuperscriptBox["\[Epsilon]", "2"]}]}], ")"}]}], ")"}], 
                    "/", 
                    SuperscriptBox["\[Epsilon]", "4"]}]}], ")"}]}]}], ")"}]}],
                 ")"}]}]}], "==", "0"}], ",", "\[Epsilon]"}], "]"}]}], ",", 
         RowBox[{"\[Epsilon]", "/.", 
          RowBox[{"Solve", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"zetak", "-", "1", "-", 
              RowBox[{
               SuperscriptBox["\[Epsilon]", "2"], "*", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"1", "/", "2"}], ")"}], " ", 
                 RowBox[{"(", 
                  RowBox[{"g2", "+", "g3", "+", 
                   RowBox[{"\[Sqrt]", 
                    RowBox[{"(", 
                    RowBox[{
                    SuperscriptBox[
                    RowBox[{"(", 
                    RowBox[{"g2", "-", "g3"}], ")"}], "2"], "+", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"4", " ", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"2", " ", "\[CapitalDelta]k"}], "+", 
                    RowBox[{"g1", " ", 
                    SuperscriptBox["\[Epsilon]", "2"]}]}], ")"}], " ", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"-", "2"}], " ", "\[CapitalDelta]k"}], "+", 
                    RowBox[{"g4", " ", 
                    SuperscriptBox["\[Epsilon]", "2"]}]}], ")"}]}], ")"}], 
                    "/", 
                    SuperscriptBox["\[Epsilon]", "4"]}]}], ")"}]}]}], ")"}]}],
                 ")"}]}]}], "==", "0"}], ",", "\[Epsilon]"}], "]"}]}]}], 
        "}"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"mainsol", "=", 
     RowBox[{"Min", "[", 
      RowBox[{"Select", "[", 
       RowBox[{"allsol", ",", 
        RowBox[{
         RowBox[{
          RowBox[{
