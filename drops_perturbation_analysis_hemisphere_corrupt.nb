Cell[BoxData[
 RowBox[{
  RowBox[{"b301", "[", 
   RowBox[{
   "oh_", ",", "\[Rho]1_", ",", "\[Rho]2_", ",", "\[Mu]1_", ",", "\[Mu]2_", 
    ",", "kr_", ",", "lr_"}], "]"}], ":=", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"Clear", "[", 
     RowBox[{
     "f1", ",", "f2", ",", "f3", ",", "f4", ",", "f5", ",", 
      "\[CapitalDelta]k", ",", "k", ",", "eta1", ",", "b020", ",", "b021", 
      ",", "b030", ",", "forcing301"}], "]"}], ";", 
    RowBox[{"k", "=", "3"}], ";", 
    RowBox[{"l", "=", "0"}], ";", "\[IndentingNewLine]", 
    RowBox[{"eta1", "=", 
     RowBox[{
      RowBox[{"b020", "*", 
       RowBox[{"realkl", "[", 
        RowBox[{"2", ",", "0"}], "]"}]}], "+", 
      RowBox[{
       RowBox[{"(", "b021", ")"}], "*", 
       RowBox[{"realkl", "[", 
        RowBox[{"2", ",", "1"}], "]"}]}], "+", 
      RowBox[{"b030", "*", 
       RowBox[{"realkl", "[", 
        RowBox[{"3", ",", "0"}], "]"}]}]}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"tkl1", "=", 
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{"eta1", "*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"mkl", "[", 
            RowBox[{"2", ",", "0"}], "]"}], "*", 
           RowBox[{"realkl", "[", 
            RowBox[{"2", ",", "0"}], "]"}]}], "+", 
          RowBox[{
           RowBox[{"mkl", "[", 
            RowBox[{"2", ",", "1"}], "]"}], "*", 
           RowBox[{"realkl", "[", 
            RowBox[{"2", ",", "1"}], "]"}]}], "+", 
          RowBox[{
           RowBox[{"mkl", "[", 
            RowBox[{"3", ",", "0"}], "]"}], "*", 
           RowBox[{"realkl", "[", 
            RowBox[{"3", ",", "0"}], "]"}]}]}], ")"}], "*", 
        RowBox[{"realkl", "[", 
         RowBox[{"k", ",", "l"}], "]"}], "*", 
        RowBox[{"Sin", "[", "\[Theta]", "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Theta]", ",", "0", ",", "Pi"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[CurlyPhi]", ",", "0", ",", 
         RowBox[{"2", " ", "Pi"}]}], "}"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"nkl1", "=", 
     RowBox[{"n301f", "[", 
      RowBox[{
      "oh", ",", "\[Rho]1", ",", "\[Rho]2", ",", "\[Mu]1", ",", "\[Mu]2", ",",
        "kr", ",", "lr"}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"kkl1", "=", 
     RowBox[{"k301f", "[", 
      RowBox[{
      "oh", ",", "\[Rho]1", ",", "\[Rho]2", ",", "\[Mu]1", ",", "\[Mu]2", ",",
        "kr", ",", "lr"}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"lkl1", "=", 
     RowBox[{"l301f", "[", 
      RowBox[{
      "oh", ",", "\[Rho]1", ",", "\[Rho]2", ",", "\[Mu]1", ",", "\[Mu]2", ",",
        "kr", ",", "lr"}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"kkl1t", "=", 
     RowBox[{"D", "[", 
      RowBox[{"kkl1", ",", "t"}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"lkl1t", "=", 
     RowBox[{"D", "[", 
      RowBox[{"lkl1", ",", "t"}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"b020", "=", 
     RowBox[{"bkl0fun", "[", 
      RowBox[{
      "oh", ",", "\[Rho]1", ",", "\[Rho]2", ",", "\[Mu]1", ",", "\[Mu]2", ",",
        "2", ",", "0", ",", "kr", ",", "lr"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"b021", "=", 
     RowBox[{"bkl0fun", "[", 
      RowBox[{
      "oh", ",", "\[Rho]1", ",", "\[Rho]2", ",", "\[Mu]1", ",", "\[Mu]2", ",",
        "2", ",", "1", ",", "kr", ",", "lr"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"b030", "=", 
     RowBox[{"bkl0fun", "[", 
      RowBox[{
      "oh", ",", "\[Rho]1", ",", "\[Rho]2", ",", "\[Mu]1", ",", "\[Mu]2", ",",
        "3", ",", "0", ",", "kr", ",", "lr"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"wer", "=", 
     FractionBox[
      RowBox[{"kr", 
       RowBox[{"(", 
        RowBox[{"kr", "+", "1"}], ")"}], 
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["kr", "2"], "+", "kr", "-", "2"}], ")"}]}], 
      RowBox[{
       RowBox[{"\[Rho]1", "*", 
        RowBox[{"(", 
         RowBox[{"kr", "+", "1"}], ")"}]}], "+", 
       RowBox[{"\[Rho]2", "*", "kr"}]}]]}], ";", 
    RowBox[{"(*", 
     RowBox[{
     "weber", " ", "number", " ", "for", " ", "the", " ", "resonance", " ", 
      "mode"}], "*)"}], "\[IndentingNewLine]", 
    RowBox[{"delta", "=", 
     RowBox[{"oh", "/", 
      RowBox[{"(", 
       RowBox[{"\[Sqrt]", "wer"}], ")"}]}]}], ";", 
    RowBox[{"\[Zeta]k", "=", 
     SqrtBox[
      FractionBox[
       RowBox[{"k", 
        RowBox[{"(", 
         RowBox[{"k", "+", "1"}], ")"}], 
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["k", "2"], "+", "k", "-", "2"}], ")"}]}], 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"\[Rho]1", "*", 
           RowBox[{"(", 
            RowBox[{"k", "+", "1"}], ")"}]}], "+", 
          RowBox[{"\[Rho]2", "*", "k"}]}], ")"}], "wer"}]]]}], ";", 
    RowBox[{"fk", "=", 
     FractionBox[
      RowBox[{"k", 
       RowBox[{"(", 
        RowBox[{"k", "+", "1"}], ")"}]}], 
      RowBox[{
       RowBox[{"\[Rho]1", 
        RowBox[{"(", 
         RowBox[{"k", "+", "1"}], ")"}]}], "+", 
       RowBox[{"\[Rho]2", "*", "k"}]}]]}], ";", "\[IndentingNewLine]", 
    RowBox[{"\[CapitalDelta]k", "=", 
     RowBox[{"delta", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"\[Mu]1", "*", 
         RowBox[{"(", 
          RowBox[{"k", "-", "1"}], ")"}]}], "+", 
        RowBox[{"\[Mu]2", "*", 
         RowBox[{"(", 
          RowBox[{"k", "+", "2"}], ")"}]}]}], ")"}], "*", "fk"}]}], ";", 
    RowBox[{"gk", "=", 
     FractionBox[
      RowBox[{"\[Rho]2", "*", "k"}], 
      RowBox[{
       RowBox[{"\[Rho]1", "*", 
        RowBox[{"(", 
         RowBox[{"k", "+", "1"}], ")"}]}], "+", 
       RowBox[{"\[Rho]2", "*", "k"}]}]]}], ";", 
    RowBox[{"hk", "=", 
     RowBox[{"2", "\[Delta]", "*", "\[Mu]2", "*", 
      RowBox[{"(", 
       RowBox[{"k", "+", "2"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"forcing301", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"\[Rho]2", "-", "\[Rho]1"}], ")"}], "*", "fk", "*", "tkl1", 
       "*", 
       RowBox[{"Sin", "[", "t", "]"}]}], "-", "kkl1t", "-", 
      RowBox[{"2", "*", "\[CapitalDelta]k", "*", "kkl1"}], "-", 
      RowBox[{"gk", "*", "lkl1t"}], "-", 
      RowBox[{"hk", "*", "lkl1"}], "-", 
      RowBox[{"fk", "*", "nkl1"}]}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"f1", "=", 
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "/", 
          RowBox[{"(", 
           RowBox[{"2", "Pi"}], ")"}]}], ")"}], "*", "forcing301"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", 
         RowBox[{"-", "Pi"}], ",", "Pi"}], "}"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"f4", "=", 
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "/", "Pi"}], ")"}], "*", "forcing301", "*", 
        RowBox[{"Cos", "[", 
         RowBox[{"2", "t"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", 
         RowBox[{"-", "Pi"}], ",", "Pi"}], "}"}]}], "]"}]}], ";", 
    RowBox[{"f5", "=", 
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "/", "Pi"}], ")"}], "*", "forcing301", "*", 
        RowBox[{"Sin", "[", 
         RowBox[{"2", "t"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", 
         RowBox[{"-", "Pi"}], ",", "Pi"}], "}"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"\[CapitalDelta]k", "=", 
     RowBox[{"delta", "*", 
      RowBox[{"(", 
       RowBox[{"k", "+", "1"}], ")"}], "*", 
      RowBox[{"(", 
       RowBox[{"k", "+", "2"}], ")"}]}]}], ";", 
    RowBox[{"\[Zeta]k", "=", 
     RowBox[{"\[Sqrt]", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "/", "wer"}], ")"}], 
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["k", "2"], "-", "1"}], ")"}], 
        RowBox[{"(", 
         RowBox[{"k", "+", "2"}], ")"}]}], ")"}]}]}], ";", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"b301sol", "=", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         FractionBox["f1", 
          SuperscriptBox["\[Zeta]k", "2"]], "+", 
         FractionBox[
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"-", "4"}], " ", "f5", " ", "\[CapitalDelta]k"}], "+", 
              
              RowBox[{"f4", " ", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"-", "4"}], "+", 
                 SuperscriptBox["\[Zeta]k", "2"]}], ")"}]}]}], ")"}], " ", 
            RowBox[{"Cos", "[", 
             RowBox[{"2", " ", "t"}], "]"}]}], "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"4", " ", "f4", " ", "\[CapitalDelta]k"}], "+", 
              RowBox[{"f5", " ", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"-", "4"}], "+", 
                 SuperscriptBox["\[Zeta]k", "2"]}], ")"}]}]}], ")"}], " ", 
            RowBox[{"Sin", "[", 
             RowBox[{"2", " ", "t"}], "]"}]}]}], 
          RowBox[{
           RowBox[{"16", " ", 
            SuperscriptBox["\[CapitalDelta]k", "2"]}], "+", 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", "4"}], "+", 
              SuperscriptBox["\[Zeta]k", "2"]}], ")"}], "2"]}]]}], "//", 
        "TrigReduce"}], "//", "Simplify"}], "//", "Chop"}]}]}], 
