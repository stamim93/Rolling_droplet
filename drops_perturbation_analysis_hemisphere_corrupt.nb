Cell[BoxData[
 RowBox[{
  RowBox[{"b211", "[", 
   RowBox[{
   "oh_", ",", "\[Rho]1_", ",", "\[Rho]2_", ",", "\[Mu]1_", ",", "\[Mu]2_", 
    ",", "kr_", ",", "lr_"}], "]"}], ":=", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"Clear", "[", 
     RowBox[{
     "f1", ",", "f2", ",", "f3", ",", "f4", ",", "f5", ",", 
