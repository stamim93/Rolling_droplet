Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"bkl1fun", "[", 
    RowBox[{
    "oh_", ",", "\[Rho]1_", ",", "\[Rho]2_", ",", "\[Mu]1_", ",", "\[Mu]2_", 
     ",", "k_", ",", "l_", ",", "m_", ",", "n_"}], "]"}], ":=", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"Clear", "[", 
      RowBox[{"c0", ",", "d0", ",", "m1k", ",", "m2k"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"wem", "=", 
      FractionBox[
       RowBox[{"m", 
        RowBox[{"(", 
         RowBox[{"m", "+", "1"}], ")"}], 
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["m", "2"], "+", "m", "-", "2"}], ")"}]}], 
       RowBox[{
        RowBox[{"\[Rho]1", "*", 
         RowBox[{"(", 
          RowBox[{"m", "+", "1"}], ")"}]}], "+", 
        RowBox[{"\[Rho]2", "*", "m"}]}]]}], ";", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"kr", "=", 
        RowBox[{"number", " ", "of", " ", "resonance", " ", "mode"}]}], ",", 
       " ", 
       RowBox[{"e", ".", "g", "."}], ",", " ", 
       RowBox[{"kr", "=", "3"}]}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"delta", "=", 
      FractionBox["oh", "wem"]}], ";", "\[IndentingNewLine]", 
     RowBox[{"qk", "=", 
      RowBox[{"Integrate", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"realklpt", "[", 
          RowBox[{"k", ",", "l", ",", "\[Theta]", ",", "\[CurlyPhi]"}], "]"}],
          "*", 
         RowBox[{"Cos", "[", "\[Theta]", "]"}], "*", 
         RowBox[{"Sin", "[", "\[Theta]", "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"\[Theta]", ",", "0", ",", 
          RowBox[{"Pi", "/", "2"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\[CurlyPhi]", ",", "0", ",", 
          RowBox[{"2", "Pi"}]}], "}"}]}], "]"}]}], ";", 
     RowBox[{"(*", 
      RowBox[{"forcing", " ", "over", " ", "half", " ", "sphere"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"\[Zeta]k", "=", 
      SqrtBox[
       FractionBox[
        RowBox[{"k", 
         RowBox[{"(", 
          RowBox[{"k", "+", "1"}], ")"}], 
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["k", "2"], "+", "k", "-", "2"}], ")"}]}], 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"\[Rho]1", "*", 
            RowBox[{"(", 
             RowBox[{"k", "+", "1"}], ")"}]}], "+", 
           RowBox[{"\[Rho]2", "*", "k"}]}], ")"}], "wem"}]]]}], ";", 
     RowBox[{"nk", "=", 
      RowBox[{
       FractionBox[
        RowBox[{
         RowBox[{"(", 
          RowBox[{"\[Rho]2", "-", "\[Rho]1"}], ")"}], "*", "k", "*", 
         RowBox[{"(", 
          RowBox[{"k", "+", "1"}], ")"}]}], 
        RowBox[{
         RowBox[{"\[Rho]1", 
          RowBox[{"(", 
           RowBox[{"k", "+", "1"}], ")"}]}], "+", 
         RowBox[{"\[Rho]2", "*", "k"}]}]], "*", "qk"}]}], ";", 
