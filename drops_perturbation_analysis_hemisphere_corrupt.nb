      ",", "b030", ",", "forcing211"}], "]"}], ";", 
    RowBox[{"k", "=", "2"}], ";", 
    RowBox[{"l", "=", "1"}], ";", "\[IndentingNewLine]", 
    RowBox[{"eta1", "=", 
     RowBox[{
      RowBox[{"b020", "*", 
