Cell[BoxData[
 RowBox[{
  RowBox[{"bkl2fun", "[", 
   RowBox[{
   "oh_", ",", "bo_", ",", "\[Rho]1_", ",", "\[Rho]2_", ",", "\[Mu]1_", ",", 
    "\[Mu]2_", ",", "k_", ",", "l_", ",", "m_", ",", "n_"}], "]"}], ":=", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"Clear", "[", 
     RowBox[{
     "f1", ",", "f2", ",", "f3", ",", "f4", ",", "f5", ",", 
      "\[CapitalDelta]k", ",", "f201", ",", "wem", ",", "We", ",", "expr"}], 
     "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"expr", "=", 
     RowBox[{"kkl1fun", "/.", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"ohn", "->", "oh"}], ",", 
        RowBox[{"bond", "->", "bo"}], ",", 
        RowBox[{"rho1", "->", "\[Rho]1"}], ",", 
        RowBox[{"rho2", "->", "\[Rho]2"}], ",", 
        RowBox[{"mu1", "->", "\[Mu]1"}], ",", 
        RowBox[{"mu2", "->", "\[Mu]2"}]}], "}"}]}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{"expr", "=", 
       RowBox[{"kkl1fun", "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"ohn", "->", "0.043"}], ",", 
          RowBox[{"rho1", "->", "0.86"}], ",", 
          RowBox[{"rho2", "->", "0.14"}], ",", 
          RowBox[{"mu1", "->", "0.71"}], ",", 
          RowBox[{"mu2", "->", "0.29"}], ",", 
          RowBox[{"alpha", "->", 
           RowBox[{"Pi", "/", "2"}]}]}], "}"}]}]}], ";"}], "*)"}], 
    "\[IndentingNewLine]", 
    RowBox[{"exprsub", "=", 
     RowBox[{
      RowBox[{"Expand", "[", 
       RowBox[{"Rationalize", "[", 
        RowBox[{"expr", ",", "0"}], "]"}], "]"}], "/.", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"Cos", "[", "t", "]"}], "->", "ct"}], ",", 
        RowBox[{
         RowBox[{"Sin", "[", "t", "]"}], "->", "st"}], ",", 
        RowBox[{
         RowBox[{"Cos", "[", 
          RowBox[{"2", "t"}], "]"}], "->", "ct2"}], ",", 
        RowBox[{
         RowBox[{"Sin", "[", 
          RowBox[{"2", "t"}], "]"}], "->", "st2"}], ",", 
        RowBox[{
         RowBox[{"Cos", "[", 
          RowBox[{"3", "t"}], "]"}], "->", "ct3"}], ",", 
        RowBox[{
         RowBox[{"Sin", "[", 
          RowBox[{"3", "t"}], "]"}], "->", "st3"}]}], "}"}]}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"params", "=", 
     RowBox[{"{", 
      RowBox[{
      "c21", ",", "d21", ",", "ct", ",", "st", ",", "ct2", ",", "st2", ",", 
       "ct3", ",", "st3"}], "}"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"rules", "=", 
     RowBox[{"CoefficientRules", "[", 
      RowBox[{"exprsub", ",", "params"}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"integratedRules", "=", 
     RowBox[{"ParallelMap", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", 
          RowBox[{"Integrate", "[", 
           RowBox[{
            RowBox[{"TrigReduce", "[", 
             RowBox[{
              RowBox[{"Expand", "[", 
               RowBox[{"#", "[", 
                RowBox[{"[", "2", "]"}], "]"}], "]"}], "*", 
              RowBox[{"realklpt", "[", 
               RowBox[{"2", ",", "1", ",", "\[Theta]", ",", "\[CurlyPhi]"}], 
               "]"}], "*", 
              RowBox[{"Sin", "[", "\[Theta]", "]"}]}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"\[Theta]", ",", "0", ",", "\[Pi]"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"\[CurlyPhi]", ",", "0", ",", 
              RowBox[{"2", " ", "\[Pi]"}]}], "}"}]}], "]"}]}], "}"}], "&"}], 
       ",", "rules"}], "]"}]}], ";", "\n", 
    RowBox[{"(*", "Reassemble", "*)"}], "\[IndentingNewLine]", 
    RowBox[{"kkl1ff", "=", 
     RowBox[{
      RowBox[{"Rationalize", "[", 
       RowBox[{
        RowBox[{"FullSimplify", "[", 
         RowBox[{"N", "[", 
          RowBox[{"Total", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Times", "[", 
              RowBox[{
               RowBox[{"Inner", "[", 
                RowBox[{"Power", ",", "params", ",", 
                 RowBox[{"#", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], ",", "Times"}], "]"}], ",", 
               
               RowBox[{"#", "[", 
                RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "&"}], "/@", 
            "integratedRules"}], "]"}], "]"}], "]"}], ",", "0"}], "]"}], "/.",
       " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"ct", "->", 
         RowBox[{"Cos", "[", "t", "]"}]}], ",", 
        RowBox[{"st", "->", 
         RowBox[{"Sin", "[", "t", "]"}]}], ",", 
        RowBox[{"ct2", "->", 
         RowBox[{"Cos", "[", 
          RowBox[{"2", "t"}], "]"}]}], ",", 
        RowBox[{"st2", "->", 
         RowBox[{"Sin", "[", 
          RowBox[{"2", "t"}], "]"}]}], ",", 
        RowBox[{"ct3", "->", 
         RowBox[{"Cos", "[", 
          RowBox[{"3", "t"}], "]"}]}], ",", 
        RowBox[{"st3", "->", 
         RowBox[{"Sin", "[", 
          RowBox[{"3", "t"}], "]"}]}]}], "}"}]}]}], ";", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"expr", "=", 
     RowBox[{"lkl1fun", "/.", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"ohn", "->", "oh"}], ",", 
        RowBox[{"bond", "->", "bo"}], ",", 
        RowBox[{"rho1", "->", "\[Rho]1"}], ",", 
        RowBox[{"rho2", "->", "\[Rho]2"}], ",", 
        RowBox[{"mu1", "->", "\[Mu]1"}], ",", 
        RowBox[{"mu2", "->", "\[Mu]2"}]}], "}"}]}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"exprsub", "=", 
     RowBox[{
      RowBox[{"Expand", "[", 
       RowBox[{"Rationalize", "[", 
        RowBox[{"expr", ",", "0"}], "]"}], "]"}], "/.", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"Cos", "[", "t", "]"}], "->", "ct"}], ",", 
        RowBox[{
         RowBox[{"Sin", "[", "t", "]"}], "->", "st"}], ",", 
        RowBox[{
         RowBox[{"Cos", "[", 
          RowBox[{"2", "t"}], "]"}], "->", "ct2"}], ",", 
        RowBox[{
         RowBox[{"Sin", "[", 
          RowBox[{"2", "t"}], "]"}], "->", "st2"}], ",", 
        RowBox[{
         RowBox[{"Cos", "[", 
          RowBox[{"3", "t"}], "]"}], "->", "ct3"}], ",", 
        RowBox[{
         RowBox[{"Sin", "[", 
          RowBox[{"3", "t"}], "]"}], "->", "st3"}]}], "}"}]}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"params", "=", 
     RowBox[{"{", 
      RowBox[{
      "c21", ",", "d21", ",", "ct", ",", "st", ",", "ct2", ",", "st2", ",", 
       "ct3", ",", "st3"}], "}"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"rules", "=", 
     RowBox[{"CoefficientRules", "[", 
      RowBox[{"exprsub", ",", "params"}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"integratedRules", "=", 
     RowBox[{"ParallelMap", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", 
          RowBox[{"Integrate", "[", 
           RowBox[{
            RowBox[{"TrigReduce", "[", 
             RowBox[{
              RowBox[{"Expand", "[", 
               RowBox[{"#", "[", 
                RowBox[{"[", "2", "]"}], "]"}], "]"}], "*", 
              RowBox[{"realklpt", "[", 
               RowBox[{"k", ",", "l", ",", "\[Theta]", ",", "\[CurlyPhi]"}], 
               "]"}], "*", 
              RowBox[{"Sin", "[", "\[Theta]", "]"}]}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"\[Theta]", ",", "0", ",", "\[Pi]"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"\[CurlyPhi]", ",", "0", ",", 
              RowBox[{"2", " ", "\[Pi]"}]}], "}"}]}], "]"}]}], "}"}], "&"}], 
       ",", "rules"}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"(*", "Reassemble", "*)"}], "\n", 
    RowBox[{"lkl1ff", "=", 
     RowBox[{
      RowBox[{"Rationalize", "[", 
       RowBox[{
        RowBox[{"FullSimplify", "[", 
         RowBox[{"N", "[", 
          RowBox[{"Total", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Times", "[", 
              RowBox[{
               RowBox[{"Inner", "[", 
                RowBox[{"Power", ",", "params", ",", 
                 RowBox[{"#", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], ",", "Times"}], "]"}], ",", 
               
               RowBox[{"#", "[", 
                RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "&"}], "/@", 
            "integratedRules"}], "]"}], "]"}], "]"}], ",", "0"}], "]"}], "/.",
       " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"ct", "->", 
         RowBox[{"Cos", "[", "t", "]"}]}], ",", 
        RowBox[{"st", "->", 
         RowBox[{"Sin", "[", "t", "]"}]}], ",", 
        RowBox[{"ct2", "->", 
         RowBox[{"Cos", "[", 
          RowBox[{"2", "t"}], "]"}]}], ",", 
        RowBox[{"st2", "->", 
         RowBox[{"Sin", "[", 
          RowBox[{"2", "t"}], "]"}]}], ",", 
        RowBox[{"ct3", "->", 
         RowBox[{"Cos", "[", 
          RowBox[{"3", "t"}], "]"}]}], ",", 
        RowBox[{"st3", "->", 
         RowBox[{"Sin", "[", 
          RowBox[{"3", "t"}], "]"}]}]}], "}"}]}]}], ";", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"wem", "=", 
     FractionBox[
      RowBox[{"m", 
       RowBox[{"(", 
        RowBox[{"m", "+", "1"}], ")"}], 
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["m", "2"], "+", "m", "-", "2"}], ")"}]}], 
      RowBox[{
       RowBox[{"\[Rho]1", "*", 
        RowBox[{"(", 
         RowBox[{"m", "+", "1"}], ")"}]}], "+", 
       RowBox[{"\[Rho]2", "*", "m"}]}]]}], ";", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"expr", "=", 
     RowBox[{"nkl1fun", "/.", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"ohn", "->", "oh"}], ",", 
        RowBox[{"bond", "->", "bo"}], ",", 
        RowBox[{"rho1", "->", "\[Rho]1"}], ",", 
        RowBox[{"rho2", "->", "\[Rho]2"}], ",", 
