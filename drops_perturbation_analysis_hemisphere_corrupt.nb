Cell[BoxData[
 RowBox[{
  RowBox[{"b102fun", "[", 
   RowBox[{
   "oh_", ",", "\[Rho]1_", ",", "\[Rho]2_", ",", "\[Mu]1_", ",", "\[Mu]2_", 
    ",", "m_", ",", "n_"}], "]"}], ":=", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"Clear", "[", 
     RowBox[{
     "f1", ",", "f2", ",", "f3", ",", "f4", ",", "f5", ",", 
      "\[CapitalDelta]k", ",", "k", ",", "f201", ",", "wem", ",", "We"}], 
     "]"}], ";", 
    RowBox[{"k", "=", "1"}], ";", "\[IndentingNewLine]", 
    RowBox[{"wem", "=", 
     FractionBox[
      RowBox[{"m", 
       RowBox[{"(", 
        RowBox[{"m", "+", "1"}], ")"}], 
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["m", "2"], "+", "m", "-", "2"}], ")"}]}], 
      RowBox[{
       RowBox[{"\[Rho]1", "*", 
        RowBox[{"(", 
         RowBox[{"m", "+", "1"}], ")"}]}], "+", 
       RowBox[{"\[Rho]2", "*", "m"}]}]]}], ";", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{"kr", "=", 
       RowBox[{"number", " ", "of", " ", "resonance", " ", "mode"}]}], ",", 
      " ", 
      RowBox[{"e", ".", "g", "."}], ",", " ", 
      RowBox[{"kr", "=", "3"}]}], "*)"}], "\[IndentingNewLine]", 
    RowBox[{"delta", "=", 
     FractionBox["oh", "wem"]}], ";", 
    RowBox[{"We", "=", "wem"}], ";", "\[IndentingNewLine]", 
    RowBox[{"qk", "=", 
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"realklpt", "[", 
