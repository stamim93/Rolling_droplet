Cell[BoxData[
 RowBox[{
  RowBox[{"magkl1mn", "[", 
   RowBox[{
   "oh_", ",", "\[Rho]1_", ",", "\[Rho]2_", ",", "\[Mu]1_", ",", "\[Mu]2_", 
    ",", "k_", ",", "l_", ",", "m_", ",", "n_"}], "]"}], ":=", 
  RowBox[{"(", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"wer", "=", 
     FractionBox[
      RowBox[{"m", 
       RowBox[{"(", 
        RowBox[{"m", "+", "1"}], ")"}], 
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["m", "2"], "+", "m", "-", "2"}], ")"}]}], 
      RowBox[{
       RowBox[{"\[Rho]1", "*", 
        RowBox[{"(", 
         RowBox[{"m", "+", "1"}], ")"}]}], "+", 
       RowBox[{"\[Rho]2", "*", "m"}]}]]}], ";", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{"kr", "=", 
       RowBox[{"number", " ", "of", " ", "resonance", " ", "mode"}]}], ",", 
      " ", 
      RowBox[{"e", ".", "g", "."}], ",", " ", 
      RowBox[{"kr", "=", "3"}]}], "*)"}], "\[IndentingNewLine]", 
    RowBox[{"delta", "=", 
     FractionBox["oh", "wer"]}], ";", "\[IndentingNewLine]", 
    RowBox[{"qkl", "=", 
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"realklpt", "[", 
         RowBox[{"k", ",", "0", ",", "\[Theta]", ",", "\[CurlyPhi]"}], "]"}], 
        "*", 
        RowBox[{"realklpt", "[", 
         RowBox[{"k", ",", "l", ",", "\[Theta]", ",", "\[CurlyPhi]"}], "]"}], 
        "*", 
        RowBox[{"Sin", "[", "\[Theta]", "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Theta]", ",", "0", ",", "Pi"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[CurlyPhi]", ",", "0", ",", 
         RowBox[{"2", "Pi"}]}], "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
    
    RowBox[{"\[Zeta]k", "=", 
     SqrtBox[
      FractionBox[
       RowBox[{"k", 
        RowBox[{"(", 
         RowBox[{"k", "+", "1"}], ")"}], 
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["k", "2"], "+", "k", "-", "2"}], ")"}]}], 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"\[Rho]1", "*", 
           RowBox[{"(", 
            RowBox[{"k", "+", "1"}], ")"}]}], "+", 
          RowBox[{"\[Rho]2", "*", "k"}]}], ")"}], "wer"}]]]}], ";", 
    RowBox[{"nk", "=", 
     RowBox[{
      FractionBox[
       RowBox[{
        RowBox[{"(", 
         RowBox[{"\[Rho]2", "-", "\[Rho]1"}], ")"}], "*", "k", "*", 
        RowBox[{"(", 
         RowBox[{"k", "+", "1"}], ")"}]}], 
       RowBox[{
        RowBox[{"\[Rho]1", 
         RowBox[{"(", 
          RowBox[{"k", "+", "1"}], ")"}]}], "+", 
        RowBox[{"\[Rho]2", "*", "k"}]}]], "*", 
      SqrtBox[
       FractionBox[
        RowBox[{
         RowBox[{"2", "k"}], "+", "1"}], 
        RowBox[{"4", "*", "Pi"}]]], "*", "qk"}]}], ";", 
    RowBox[{"gk", "=", 
     FractionBox[
      RowBox[{"k", 
       RowBox[{"(", 
        RowBox[{"k", "+", "1"}], ")"}]}], 
      RowBox[{
       RowBox[{"\[Rho]1", 
        RowBox[{"(", 
         RowBox[{"k", "+", "1"}], ")"}]}], "+", 
       RowBox[{"\[Rho]2", "*", "k"}]}]]}], ";", 
    RowBox[{"\[CapitalDelta]k", "=", 
     RowBox[{"delta", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"\[Mu]1", "*", 
         RowBox[{"(", 
          RowBox[{"k", "-", "1"}], ")"}]}], "+", 
        RowBox[{"\[Mu]2", "*", 
         RowBox[{"(", 
          RowBox[{"k", "+", "2"}], ")"}]}]}], ")"}], "*", "gk"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"magkl", "=", 
     FractionBox[
      RowBox[{"2", 
       RowBox[{"(", 
        RowBox[{"k", "+", "1"}], ")"}], "*", 
       RowBox[{"Abs", "[", "qkl", "]"}]}], 
      SqrtBox[
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"1", "-", 
           SuperscriptBox["\[Zeta]k", "2"]}], ")"}], "2"], "+", 
        RowBox[{"4", "*", 
         SuperscriptBox["\[CapitalDelta]k", "2"]}]}]]]}]}], 
   "\[IndentingNewLine]", ")"}]}]], "Input",
 CellChangeTimes->{{3.981377899481976*^9, 3.9813780131506147`*^9}, {
   3.981378048107443*^9, 3.9813780487578506`*^9}, {3.981389617104637*^9, 
