Cell[BoxData[
 RowBox[{"Clear", "[", 
  RowBox[{"nk", ",", "\[Zeta]k", ",", "\[CapitalDelta]k"}], "]"}]], "Input",
 CellChangeTimes->{{3.983882108105988*^9, 3.9838821138418913`*^9}},
 CellLabel->
  "In[226]:=",ExpressionUUID->"ff02c6c4-057e-46f1-9339-5e36636f6c93"],

Cell[BoxData[
 RowBox[{
  RowBox[{"m1k", "=", 
   FractionBox[
    RowBox[{"nk", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "1"}], "+", 
       SuperscriptBox["\[Zeta]k", "2"]}], ")"}]}], 
    RowBox[{
     RowBox[{"4", " ", 
      SuperscriptBox["\[CapitalDelta]k", "2"]}], "+", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "+", 
        SuperscriptBox["\[Zeta]k", "2"]}], ")"}], "2"]}]]}], ";", 
  RowBox[{"m2k", "=", 
   FractionBox[
    RowBox[{"2", " ", "\[CapitalDelta]k", "*", "nk"}], 
    RowBox[{
     RowBox[{"4", " ", 
      SuperscriptBox["\[CapitalDelta]k", "2"]}], "+", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "+", 
        SuperscriptBox["\[Zeta]k", "2"]}], ")"}], "2"]}]]}], ";"}]], "Input",
 CellLabel->
  "In[227]:=",ExpressionUUID->"0a7d7667-f4e8-4ffb-a972-babca9f795cf"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  SuperscriptBox[
   RowBox[{"(", 
    RowBox[{
     SuperscriptBox["m1k", "2"], "+", 
     SuperscriptBox["m2k", "2"]}], ")"}], 
   RowBox[{"1", "/", "2"}]], "//", "FullSimplify"}]], "Input",
 CellChangeTimes->{{3.983882128572925*^9, 3.9838821402385883`*^9}},
 CellLabel->
  "In[229]:=",ExpressionUUID->"dec4ad64-0755-4f76-84b3-04bcba252465"],

Cell[BoxData[
 SqrtBox[
  FractionBox[
   SuperscriptBox["nk", "2"], 
   RowBox[{
    RowBox[{"4", " ", 
     SuperscriptBox["\[CapitalDelta]k", "2"]}], "+", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "1"}], "+", 
       SuperscriptBox["\[Zeta]k", "2"]}], ")"}], "2"]}]]]], "Output",
 CellChangeTimes->{{3.983882137226033*^9, 3.983882140622224*^9}},
 CellLabel->
  "Out[229]=",ExpressionUUID->"494786a1-e5ee-4d9c-a38c-6c6defc0fc8a"]
}, Open  ]],

Cell[BoxData[
 RowBox[{
  RowBox[{"magkl1mn", "[", 
   RowBox[{
   "oh_", ",", "\[Rho]1_", ",", "\[Rho]2_", ",", "\[Mu]1_", ",", "\[Mu]2_", 
    ",", "k_", ",", "l_", ",", "m_"}], "]"}], ":=", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"Clear", "[", 
     RowBox[{"c0", ",", "d0", ",", "m1k", ",", "m2k"}], "]"}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"wem", "=", 
     FractionBox[
      RowBox[{"m", 
       RowBox[{"(", 
        RowBox[{"m", "+", "1"}], ")"}], 
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["m", "2"], "+", "m", "-", "2"}], ")"}]}], 
      RowBox[{
       RowBox[{"\[Rho]1", "*", 
        RowBox[{"(", 
         RowBox[{"m", "+", "1"}], ")"}]}], "+", 
       RowBox[{"\[Rho]2", "*", "m"}]}]]}], ";", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{"kr", "=", 
       RowBox[{"number", " ", "of", " ", "resonance", " ", "mode"}]}], ",", 
      " ", 
      RowBox[{"e", ".", "g", "."}], ",", " ", 
      RowBox[{"kr", "=", "3"}]}], "*)"}], "\[IndentingNewLine]", 
    RowBox[{"delta", "=", 
     FractionBox["oh", "wem"]}], ";", "\[IndentingNewLine]", 
    RowBox[{"qk", "=", 
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"realklpt", "[", 
         RowBox[{"k", ",", "0", ",", "\[Theta]", ",", "\[CurlyPhi]"}], "]"}], 
        "*", 
        RowBox[{"realklpt", "[", 
         RowBox[{"k", ",", "l", ",", "\[Theta]", ",", "\[CurlyPhi]"}], "]"}], 
        "*", 
        RowBox[{"Sin", "[", "\[Theta]", "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Theta]", ",", "0", ",", "Pi"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[CurlyPhi]", ",", "0", ",", 
         RowBox[{"2", "Pi"}]}], "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
    
    RowBox[{"\[Zeta]k", "=", 
     SqrtBox[
      FractionBox[
       RowBox[{"k", 
        RowBox[{"(", 
         RowBox[{"k", "+", "1"}], ")"}], 
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["k", "2"], "+", "k", "-", "2"}], ")"}]}], 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"\[Rho]1", "*", 
           RowBox[{"(", 
            RowBox[{"k", "+", "1"}], ")"}]}], "+", 
          RowBox[{"\[Rho]2", "*", "k"}]}], ")"}], "wem"}]]]}], ";", 
    RowBox[{"nk", "=", 
     RowBox[{
      FractionBox[
       RowBox[{
        RowBox[{"(", 
         RowBox[{"\[Rho]1", "-", "\[Rho]2"}], ")"}], "*", "k", "*", 
        RowBox[{"(", 
         RowBox[{"k", "+", "1"}], ")"}]}], 
       RowBox[{
        RowBox[{"\[Rho]1", 
         RowBox[{"(", 
          RowBox[{"k", "+", "1"}], ")"}]}], "+", 
        RowBox[{"\[Rho]2", "*", "k"}]}]], "*", 
      SqrtBox[
       FractionBox[
        RowBox[{
         RowBox[{"2", "k"}], "+", "1"}], 
        RowBox[{"4", "*", "Pi"}]]], "*", "qk"}]}], ";", 
    RowBox[{"fk", "=", 
     FractionBox[
      RowBox[{"k", 
       RowBox[{"(", 
        RowBox[{"k", "+", "1"}], ")"}]}], 
      RowBox[{
       RowBox[{"\[Rho]1", 
        RowBox[{"(", 
         RowBox[{"k", "+", "1"}], ")"}]}], "+", 
       RowBox[{"\[Rho]2", "*", "k"}]}]]}], ";", 
    RowBox[{"\[CapitalDelta]k", "=", 
     RowBox[{"delta", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"\[Mu]1", "*", 
         RowBox[{"(", 
          RowBox[{"k", "-", "1"}], ")"}]}], "+", 
        RowBox[{"\[Mu]2", "*", 
         RowBox[{"(", 
          RowBox[{"k", "+", "2"}], ")"}]}]}], ")"}], "*", "fk"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{"m1k", "=", 
       FractionBox[
        RowBox[{"nk", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "1"}], "+", 
           SuperscriptBox["\[Zeta]k", "2"]}], ")"}]}], 
        RowBox[{
         RowBox[{"4", " ", 
          SuperscriptBox["\[CapitalDelta]k", "2"]}], "+", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "1"}], "+", 
            SuperscriptBox["\[Zeta]k", "2"]}], ")"}], "2"]}]]}], ";", 
      RowBox[{"m2k", "=", 
       FractionBox[
        RowBox[{"2", " ", "\[CapitalDelta]k", "*", "nk"}], 
        RowBox[{
         RowBox[{"4", " ", 
          SuperscriptBox["\[CapitalDelta]k", "2"]}], "+", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "1"}], "+", 
            SuperscriptBox["\[Zeta]k", "2"]}], ")"}], "2"]}]]}], ";"}], 
     "*)"}], "\[IndentingNewLine]", 
    RowBox[{"magkl", "=", 
     FractionBox[
      RowBox[{"Abs", "[", "nk", "]"}], 
      SqrtBox[
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"1", "-", 
           SuperscriptBox["\[Zeta]k", "2"]}], ")"}], "2"], "+", 
        RowBox[{"4", "*", 
         SuperscriptBox["\[CapitalDelta]k", "2"]}]}]]]}]}], 
   "\[IndentingNewLine]", ")"}]}]], "Input",
 CellChangeTimes->{{3.981377899481976*^9, 3.9813780131506147`*^9}, {
   3.981378048107443*^9, 3.9813780487578506`*^9}, {3.981389617104637*^9, 
   3.981389619733247*^9}, {3.983315962808919*^9, 3.983315987818914*^9}, {
   3.983316031531952*^9, 3.98331612513864*^9}, {3.983316163247862*^9, 
   3.983316182651073*^9}, 3.983881465951466*^9, {3.983881832058529*^9, 
   3.983881855250567*^9}, {3.983882051602127*^9, 3.983882066507771*^9}, {
