           RowBox[{"dmn", "*", 
            RowBox[{"Sin", "[", 
             RowBox[{"\[Zeta]k", "*", "t"}], "]"}]}]}], ")"}], "+", 
         RowBox[{"m1k", "*", 
          RowBox[{"Cos", "[", "t", "]"}]}], "+", 
         RowBox[{"m2k", "*", 
          RowBox[{"Sin", "[", "t", "]"}]}]}], ",", 
        RowBox[{
         RowBox[{"m1k", "*", 
          RowBox[{"Cos", "[", "t", "]"}]}], "+", 
         RowBox[{"m2k", "*", 
          RowBox[{"Sin", "[", "t", "]"}]}]}]}], "]"}]}]}], ")"}]}], 
  RowBox[{"(*", 
   RowBox[{
   "leading", " ", "order", " ", "amplitude", " ", "of", " ", "different", 
    " ", "modes", " ", "at", " ", "the", " ", "resonance", " ", "frequency", 
    " ", "kr"}], "*)"}], "\[IndentingNewLine]"}]], "Input",
