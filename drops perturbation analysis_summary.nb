            RowBox[{"4", " ", 
             SuperscriptBox["\[CapitalDelta]k", "2"]}], "+", 
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{
               RowBox[{"-", "1"}], "+", "\[Zeta]k"}], ")"}], "2"]}]]}], 
         "]"}]}], ";"}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"k", "==", "kr"}], ",", 
         RowBox[{"\[Zeta]k", "=", "1"}]}], "]"}], ";"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"bkl0amp", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"k", "==", "m"}], "&&", 
         RowBox[{"l", "==", "n"}]}], ",", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"cmn", "*", 
            RowBox[{"Cos", "[", 
